@using EVrtic.Models
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject UserManager<Korisnik> UserManager
@inject EVrtic.Data.ApplicationDbContext DbContext

@{
    ViewData["Title"] = "Roditelj početna";

    var korisnik = await UserManager.GetUserAsync(User);

    Roditelj? roditelj = null;
    List<Dijete> djeca = new List<Dijete>();

    if (korisnik != null)
    {
        roditelj = await DbContext.Roditelji
            .FirstOrDefaultAsync(r => r.Id == korisnik.Id);

        if (roditelj != null)
        {
            djeca = await DbContext.Djeca
                .Where(d => d.RoditeljId == roditelj.Id && d.ImePrezime != string.Empty && d.Aktivno)
                .OrderBy(d => d.ImePrezime)
                .ToListAsync();
        }
    }

    int brojNovihObavijesti = 0;

if (korisnik != null)
{
    brojNovihObavijesti = await DbContext.Obavijesti
        .CountAsync(o => o.RoditeljId == korisnik.Id &&
            (o.StatusObavijesti == StatusObavijesti.POSLANA ||
             o.StatusObavijesti == StatusObavijesti.KREIRANA));
}
}

<div class="parent-page">
    <div class="parent-card">

        <aside class="parent-sidebar">
            <h1 class="sidebar-logo">eVrtić</h1>

            <nav class="sidebar-menu">
                <a class="sidebar-link active" asp-controller="Home" asp-action="RoditeljHome">
                    <span>🏠</span> Početna
                </a>

                <a class="sidebar-link" asp-controller="DnevniIzvjestaj" asp-action="RoditeljPregled">
                    <span>📋</span> Izvještaji
                </a>

                <a class="sidebar-link" asp-controller="EvidencijaDolaskaOdlaska" asp-action="RoditeljEvidencija">
                    <span>📅</span> Dolazak/Odlazak
                </a>

                <a class="sidebar-link" asp-controller="SazetakAktivnosti" asp-action="RoditeljPregled">
                    <span>📊</span> Sažeci
                </a>

                <a class="sidebar-link" asp-controller="Obavijest" asp-action="RoditeljPregled">
                    <span>🔔</span> Obavijesti
                </a>

                <a class="sidebar-link" asp-controller="Roditelj" asp-action="MojProfil">
                    <span>👤</span> Profil
                </a>
            </nav>

            <div class="sidebar-illustration">
                <div class="mini-cloud mini-cloud-1"></div>
                <div class="mini-cloud mini-cloud-2"></div>

                <div class="mini-school">
                    <div class="mini-roof"></div>
                    <div class="mini-building">
                        <div class="mini-window"></div>
                        <div class="mini-door"></div>
                        <div class="mini-window"></div>
                    </div>
                </div>

                <div class="mini-tree tree-one"></div>
                <div class="mini-tree tree-two"></div>
                <div class="mini-tree tree-three"></div>
            </div>
        </aside>

        <main class="parent-main">
            <div class="parent-top">
                <div>
                    <h2>Pozdrav,</h2>
                    <h1>@(roditelj?.ImePrezime?.Split(' ')[0] ?? "Roditelju")! <span>👋</span></h1>
                </div>

<a class="notification-icon notification-top-icon" asp-controller="Obavijest" asp-action="RoditeljPregled">
    🔔

    @if (brojNovihObavijesti > 0)
    {
        <span class="notification-top-badge">@brojNovihObavijesti</span>
    }
</a>        
</div>

            <h3 class="section-title" style="margin-bottom:14px;">Moja djeca</h3>

            <section class="djeca-grid">
                @foreach (var dijete in djeca)
                {
                    <a class="dijete-card" asp-controller="Dijete" asp-action="MojeDijete" asp-route-id="@dijete.Id">
                        <div class="dijete-avatar">🧒</div>

                        <div class="dijete-info">
                            <h4>@dijete.ImePrezime</h4>
                        </div>

                        <span class="dijete-arrow">→</span>
                    </a>
                }

                <a class="dijete-card dijete-card-add" asp-controller="Dijete" asp-action="DodajDijete">
                    <div class="dijete-add-icon">＋</div>

                    <div class="dijete-info">
                        <h4>Dodaj dijete</h4>
                        <p>Unesi identifikacioni kod</p>
                    </div>

                    <span class="dijete-arrow">→</span>
                </a>
            </section>

            <h3 class="section-title">Brzi pristup</h3>

            <section class="quick-grid">
                <a class="quick-card" asp-controller="DnevniIzvjestaj" asp-action="RoditeljPregled">
                    <div class="quick-icon green">📋</div>

                    <div>
                        <h4>Dnevni izvještaji</h4>
                        <p>Pregledajte dnevne aktivnosti i izvještaje vašeg djeteta.</p>
                    </div>

                    <span>→</span>
                </a>

                <a class="quick-card" asp-controller="SazetakAktivnosti" asp-action="RoditeljPregled">
                    <div class="quick-icon blue">📊</div>

                    <div>
                        <h4>Sažeci aktivnosti</h4>
                        <p>Pregledajte sedmične i mjesečne sažetke aktivnosti.</p>
                    </div>

                    <span>→</span>
                </a>

                <a class="quick-card" asp-controller="EvidencijaDolaskaOdlaska" asp-action="RoditeljEvidencija">
                    <div class="quick-icon cyan">🚪</div>

                    <div>
                        <h4>Dolazak/Odlazak</h4>
                        <p>Evidentirajte dolazak ili odlazak djeteta unosom koda.</p>
                    </div>

                    <span>→</span>
                </a>

         <a class="quick-card notification-quick-card" asp-controller="Obavijest" asp-action="RoditeljPregled">
    <div class="quick-icon pink">🔔</div>

    <div class="quick-text">
        <h4>
            Obavijesti

            @if (brojNovihObavijesti > 0)
            {
                <span class="notification-badge">@brojNovihObavijesti</span>
            }
        </h4>

        <p>Pogledajte najnovije obavijesti i važne informacije.</p>
    </div>

    <span>→</span>
</a>
            </section>
        </main>

    </div>
</div>

<style>
    .notification-top-icon {
    position: relative;
}

.notification-top-badge {
    position: absolute;
    top: -8px;
    right: -10px;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    border-radius: 999px;
    background: #ef4444;
    color: white;
    font-size: 0.72rem;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
}
    .notification-quick-card {
    position: relative;
}

.quick-text h4 {
    display: flex;
    align-items: center;
    gap: 8px;
}

.notification-badge {
    min-width: 22px;
    height: 22px;
    padding: 0 7px;
    border-radius: 999px;
    background: #ef4444;
    color: white;
    font-size: 0.78rem;
    font-weight: 900;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
}
    .djeca-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 28px;
    }

    .dijete-card {
        display: flex;
        align-items: center;
        gap: 14px;
        background: #fff;
        border: 2px solid #e2e8f0;
        border-radius: 18px;
        padding: 18px 20px;
        text-decoration: none;
        color: inherit;
        min-width: 220px;
        flex: 1;
        max-width: 300px;
        transition: border-color .2s, box-shadow .2s, transform .15s;
    }

    .dijete-card:hover {
        border-color: #93c5fd;
        box-shadow: 0 4px 16px rgba(59,130,246,.12);
        transform: translateY(-2px);
    }

    .dijete-avatar {
        font-size: 2rem;
        background: #eff6ff;
        border-radius: 50%;
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .dijete-info {
        flex: 1;
    }

    .dijete-info h4 {
        margin: 0;
        font-size: 1rem;
        font-weight: 700;
        color: #1e293b;
    }

    .dijete-info p {
        margin: 4px 0 0;
        font-size: 0.82rem;
        color: #94a3b8;
    }

    .dijete-arrow {
        color: #3b82f6;
        font-size: 1.2rem;
        font-weight: 700;
        flex-shrink: 0;
    }

    .dijete-card-add {
        background: #eff6ff;
        border: 2px dashed #93c5fd;
    }

    .dijete-card-add:hover {
        background: #dbeafe;
        border-color: #60a5fa;
    }

    .dijete-add-icon {
        font-size: 1.6rem;
        background: #3b82f6;
        color: #fff;
        border-radius: 12px;
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-weight: 300;
    }
</style>