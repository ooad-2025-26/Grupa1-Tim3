@model EVrtic.Controllers.RoditeljSazetakPregledViewModel

@{
    ViewData["Title"] = "Pregled sažetka";
}

<div class="summary-page">
    <div class="summary-card-layout">

        <aside class="summary-sidebar">
            <h1 class="sidebar-logo">eVrtić</h1>

            <nav class="sidebar-menu">
                <a class="sidebar-link" asp-controller="Home" asp-action="RoditeljHome">
                    <span>🏠</span> Početna
                </a>

                <a class="sidebar-link" asp-controller="DnevniIzvjestaj" asp-action="RoditeljPregled">
                    <span>📋</span> Izvještaji
                </a>
                
                <a class="sidebar-link" asp-controller="EvidencijaDolaskaOdlaska" asp-action="RoditeljEvidencija">
                    <span>🗓️</span> Dolazak/Odlazak
                </a>

                <a class="sidebar-link active" asp-controller="SazetakAktivnosti" asp-action="RoditeljPregled">
                    <span>📊</span> Sažeci
                </a>

                <a class="sidebar-link" asp-controller="Obavijest" asp-action="RoditeljPregled">
                    <span>🔔</span> Obavijesti
                </a>

                <a class="sidebar-link" asp-controller="Roditelj" asp-action="MojProfil">
                    <span>👤</span> Profil
                </a>
            </nav>

            <div class="ev-sidebar-illustration">
                <div class="ev-cloud ev-cloud-left"></div>
                <div class="ev-cloud ev-cloud-right"></div>

                <div class="ev-yard">
                    <div class="ev-tree ev-tree-left"></div>
                    <div class="ev-tree ev-tree-right"></div>

                    <div class="ev-house">
                        <div class="ev-house-roof"></div>
                        <div class="ev-house-body">
                            <div class="ev-house-window"></div>
                            <div class="ev-house-door"></div>
                            <div class="ev-house-window"></div>
                        </div>
                    </div>
                </div>
            </div>
        </aside>

        <main class="summary-main">
            <div class="summary-top">
                <a asp-controller="Home" asp-action="RoditeljHome" class="back-link">←</a>
                <h1>Pregled sažetka</h1>
            </div>

            <form method="get" asp-action="RoditeljPregled" class="summary-filter">
                <div class="filter-item">
                    <label>Period</label>
                    <select name="period">
                        <option value="Sedmica" selected="@(Model.Period == "Sedmica" ? "selected" : null)">Sedmica</option>
                        <option value="Mjesec" selected="@(Model.Period == "Mjesec" ? "selected" : null)">Mjesec</option>
                    </select>
                </div>

                <div class="filter-item filter-date">
                    <label>Datum</label>
                    <div class="date-box">
                        <span>@Model.DatumPocetka.ToString("dd.MM.yyyy.") - @Model.DatumKraja.ToString("dd.MM.yyyy.")</span>
                        <span class="calendar-icon">📅</span>
                        <input type="date" name="pocetak" value="@Model.DatumPocetka.ToString("yyyy-MM-dd")" />
                    </div>
                </div>

                @if (Model.Djeca.Any())
                {
                    <div class="filter-item">
                        <label>Dijete</label>
                        <select name="dijeteId">
                            @foreach (var dijete in Model.Djeca)
                            {
                                <option value="@dijete.Id" selected="@(dijete.Id == Model.OdabraniDijeteId ? "selected" : null)">
                                    @dijete.ImePrezime
                                </option>
                            }
                        </select>
                    </div>
                }

                <button type="submit" class="filter-button">Prikaži</button>
            </form>

            @if (Model.Dijete == null)
            {
                <section class="empty-box">
                    <p>Trenutno nemate povezano dijete.</p>
                </section>
            }
            else
            {
                <section class="child-box">
                    <div class="child-avatar">🧒</div>

                    <div>
                        <h2>@Model.Dijete.ImePrezime</h2>
                        <p>Grupa: @(Model.Dijete.Grupa?.ImeGrupe ?? "Nije dodijeljena")</p>
                    </div>
                </section>

                <section class="stats-grid">
                    <div class="stat-box">
                        <div class="stat-heading">
                            <span class="stat-icon green">📗</span>
                            <h3>Broj dolazaka</h3>
                        </div>

                        <div class="stat-number">@Model.BrojDolazaka</div>
                        <p>u odabranom periodu</p>
                    </div>

                    <div class="stat-box">
                        <div class="stat-heading">
                            <span class="stat-icon blue">🍴</span>
                            <h3>Obroci</h3>
                        </div>

                        <div class="stat-number">@Model.BrojObroka</div>
                        <p>evidentiranih obroka</p>
                    </div>
                </section>

                <section class="note-box">
                    <h3>Napomena</h3>

                    @if (string.IsNullOrWhiteSpace(Model.Napomene))
                    {
                        <p>Nema napomena za odabrani period.</p>
                    }
                    else
                    {
                        <p>@Model.Napomene</p>
                    }
                </section>
            }

            <nav class="bottom-menu">
                <a asp-controller="Home" asp-action="RoditeljHome">
                    <span>🏠</span> Početna
                </a>

                <a asp-controller="DnevniIzvjestaj" asp-action="RoditeljPregled">
                    <span>📋</span> Izvještaji
                </a>

                <a class="active" asp-controller="SazetakAktivnosti" asp-action="RoditeljPregled">
                    <span>📊</span> Sažeci
                </a>

                <a asp-controller="Obavijest" asp-action="RoditeljPregled">
                    <span>🔔</span> Obavijesti
                </a>

                <a asp-controller="Roditelj" asp-action="MojProfil">
                    <span>👤</span> Profil
                </a>
            </nav>
        </main>

    </div>
</div>

<style>
    body {
        background: #eaf6ff;
    }

    .summary-page {
        min-height: 100vh;
        padding: 22px 0;
        font-family: Arial, sans-serif;
    }

    .summary-card-layout {
        width: 100%;
        max-width: 1250px;
        min-height: 760px;
        margin: 0 auto;
        background: #fff;
        border-radius: 22px;
        box-shadow: 0 8px 26px rgba(15, 23, 42, 0.08);
        display: grid;
        grid-template-columns: 235px 1fr;
        overflow: hidden;
    }

    .summary-sidebar {
        position: relative;
        border-right: 1px solid #eef2f7;
        padding: 28px 22px 0;
        overflow: hidden;
    }

    .sidebar-logo {
        margin: 0 0 34px;
        color: #15913a;
        font-size: 2.65rem;
        font-weight: 800;
        text-align: center;
    }

    .sidebar-menu {
        display: flex;
        flex-direction: column;
        gap: 12px;
        position: relative;
        z-index: 5;
    }

    .sidebar-link {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 18px;
        border-radius: 12px;
        color: #0f172a;
        text-decoration: none;
        font-size: 1rem;
        font-weight: 700;
    }

    .sidebar-link span {
        width: 24px;
        text-align: center;
        font-size: 1.25rem;
    }

    .sidebar-link.active {
        color: #15803d;
        background: #edf8e9;
    }


    .ev-sidebar-illustration {
        margin-top: auto;
        position: relative;
        width: calc(100% + 44px);
        margin-left: -22px;
        height: 230px;
        overflow: hidden;
        flex-shrink: 0;
    }

    .ev-cloud {
        position: absolute;
        background: #dff1ff;
        border-radius: 999px;
        z-index: 1;
    }

    .ev-cloud::before,
    .ev-cloud::after {
        content: "";
        position: absolute;
        background: #dff1ff;
        border-radius: 50%;
    }

    .ev-cloud-left {
        width: 52px;
        height: 14px;
        left: 60px;
        top: 50px;
    }

    .ev-cloud-left::before {
        width: 22px;
        height: 22px;
        left: 7px;
        top: -12px;
    }

    .ev-cloud-left::after {
        width: 20px;
        height: 20px;
        right: 7px;
        top: -10px;
    }

    .ev-cloud-right {
        width: 58px;
        height: 15px;
        right: 42px;
        top: 25px;
    }

    .ev-cloud-right::before {
        width: 24px;
        height: 24px;
        left: 12px;
        top: -14px;
    }

    .ev-cloud-right::after {
        width: 20px;
        height: 20px;
        right: 7px;
        top: -10px;
    }

    .ev-yard {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 145px;
        background: #96d93a;
        border-top-left-radius: 52px;
        border-top-right-radius: 52px;
        z-index: 2;
    }

    .ev-house {
        position: absolute;
        left: 50%;
        bottom: 38px;
        transform: translateX(-50%);
        width: 126px;
        height: 108px;
        z-index: 5;
    }

    .ev-house-roof {
        position: absolute;
        left: 50%;
        top: 0;
        transform: translateX(-50%);
        width: 0;
        height: 0;
        border-left: 60px solid transparent;
        border-right: 60px solid transparent;
        border-bottom: 48px solid #ff7d2b;
        z-index: 7;
    }

    .ev-house-body {
        position: absolute;
        left: 50%;
        bottom: 0;
        transform: translateX(-50%);
        width: 108px;
        height: 66px;
        background: #ffd166;
        border-radius: 7px 7px 0 0;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        gap: 12px;
        padding: 0 10px 11px;
        box-sizing: border-box;
        z-index: 6;
    }

    .ev-house-window {
        width: 18px;
        height: 24px;
        background: #5fc0ef;
        border-radius: 5px;
        margin-bottom: 3px;
    }

    .ev-house-door {
        width: 24px;
        height: 40px;
        background: #29a34a;
        border-radius: 9px 9px 0 0;
    }

    .ev-tree {
        position: absolute;
        bottom: 16px;
        width: 36px;
        height: 68px;
        background: #82bf3a;
        border-radius: 999px;
        z-index: 4;
    }

    .ev-tree::after {
        content: "";
        position: absolute;
        left: 50%;
        bottom: -43px;
        transform: translateX(-50%);
        width: 4px;
        height: 58px;
        background: #9b5f2f;
        border-radius: 999px;
    }

    .ev-tree-left {
        left: 38px;
    }

    .ev-tree-right {
        right: 38px;
    }

    .summary-main {
        padding: 38px 48px 0;
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .summary-top {
        display: flex;
        align-items: center;
        gap: 22px;
        margin-bottom: 28px;
    }

    .summary-top h1 {
        margin: 0;
        color: #0f172a;
        font-size: 2.15rem;
        font-weight: 800;
    }

    .back-link {
        color: #15803d;
        text-decoration: none;
        font-size: 2rem;
        line-height: 1;
    }

    .summary-filter {
        display: grid;
        grid-template-columns: 190px 330px 220px 115px;
        gap: 16px;
        align-items: end;
        margin-bottom: 24px;
    }

    .filter-item {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .filter-item label {
        color: #0f172a;
        font-weight: 800;
        font-size: 0.95rem;
    }

    .filter-item select,
    .date-box {
        height: 52px;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        background: #fff;
        padding: 0 14px;
        font-size: 1rem;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
    }

    .filter-item select {
        width: 100%;
    }

    .date-box {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        overflow: hidden;
    }

    .date-box input[type="date"] {
        position: absolute;
        inset: 0;
        opacity: 0;
        cursor: pointer;
    }

    .calendar-icon {
        font-size: 1.1rem;
    }

    .filter-button {
        height: 52px;
        border: none;
        border-radius: 12px;
        background: #15803d;
        color: white;
        font-size: 1rem;
        font-weight: 800;
        cursor: pointer;
    }

    .child-box,
    .stat-box,
    .note-box,
    .empty-box {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 18px rgba(15, 23, 42, 0.07);
    }

    .child-box {
        display: flex;
        align-items: center;
        gap: 24px;
        padding: 22px 26px;
        margin-bottom: 20px;
    }

    .child-avatar {
        width: 78px;
        height: 78px;
        border-radius: 50%;
        background: #dbeafe;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        flex-shrink: 0;
    }

    .child-box h2 {
        margin: 0 0 8px;
        font-size: 1.65rem;
        color: #0f172a;
        font-weight: 800;
    }

    .child-box p {
        margin: 0;
        color: #475569;
        font-size: 1.05rem;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 20px;
    }

    .stat-box {
        padding: 24px 28px;
        min-height: 170px;
    }

    .stat-heading {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .stat-heading h3 {
        margin: 0;
        color: #0f172a;
        font-size: 1.15rem;
        font-weight: 800;
    }

    .stat-icon {
        font-size: 1.45rem;
    }

    .stat-icon.green {
        color: #15803d;
    }

    .stat-icon.blue {
        color: #2563eb;
    }

    .stat-number {
        text-align: center;
        font-size: 3.4rem;
        line-height: 1;
        color: #0f172a;
        font-weight: 900;
        margin-top: 26px;
    }

    .stat-box p {
        text-align: center;
        color: #64748b;
        margin: 8px 0 0;
        font-size: 1rem;
    }

    .note-box {
        padding: 24px 28px;
        margin-bottom: 24px;
    }

    .note-box h3 {
        color: #c0560b;
        font-size: 1.25rem;
        font-weight: 800;
        margin: 0 0 14px;
    }

    .note-box p,
    .empty-box p {
        margin: 0;
        color: #0f172a;
        font-size: 1rem;
        line-height: 1.55;
        white-space: pre-line;
    }

    .empty-box {
        padding: 24px;
    }

    .bottom-menu {
        margin-top: auto;
        min-height: 74px;
        border-top: 1px solid #e5e7eb;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 54px;
    }

    .bottom-menu a {
        display: flex;
        align-items: center;
        gap: 9px;
        text-decoration: none;
        color: #475569;
        font-weight: 700;
        font-size: 0.98rem;
    }

    .bottom-menu a.active {
        color: #15803d;
    }

    @@media (max-width: 1200px) {
        .summary-card-layout {
            max-width: 100%;
            border-radius: 0;
            grid-template-columns: 220px 1fr;
        }

        .summary-main {
            padding: 32px 34px 0;
        }

        .summary-filter {
            grid-template-columns: 1fr 1fr;
        }

        .bottom-menu {
            gap: 26px;
        }
    }

    @@media (max-width: 900px) {
        .summary-card-layout {
            grid-template-columns: 1fr;
        }

        .summary-sidebar {
            display: none;
        }

        .stats-grid {
            grid-template-columns: 1fr;
        }

        .summary-filter {
            grid-template-columns: 1fr;
        }
    }
</style>