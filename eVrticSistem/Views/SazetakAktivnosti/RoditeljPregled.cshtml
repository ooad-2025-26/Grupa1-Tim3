@model EVrtic.Controllers.RoditeljSazetakPregledViewModel

@{
    ViewData["Title"] = "Pregled sažetka";
}

<div class="summary-page">
    <div class="summary-card-layout">

        <aside class="summary-sidebar">
            <h1 class="sidebar-logo">eVrtić</h1>

            <nav class="sidebar-menu">
                <a class="sidebar-link" asp-controller="Home" asp-action="RoditeljHome">
                    <span>🏠</span> Početna
                </a>

                <a class="sidebar-link" asp-controller="DnevniIzvjestaj" asp-action="RoditeljPregled">
                    <span>📋</span> Izvještaji
                </a>

                <a class="sidebar-link" asp-controller="EvidencijaDolaskaOdlaska" asp-action="RoditeljEvidencija">
                    <span>🗓️</span> Dolazak/Odlazak
                </a>

                <a class="sidebar-link active" asp-controller="SazetakAktivnosti" asp-action="RoditeljPregled">
                    <span>📊</span> Sažeci
                </a>

                <a class="sidebar-link" asp-controller="Obavijest" asp-action="RoditeljPregled">
                    <span>🔔</span> Obavijesti
                </a>

                <a class="sidebar-link" asp-controller="Roditelj" asp-action="MojProfil">
                    <span>👤</span> Profil
                </a>
            </nav>

            <div class="ev-sidebar-illustration">
                <div class="ev-cloud ev-cloud-left"></div>
                <div class="ev-cloud ev-cloud-right"></div>

                <div class="ev-yard">
                    <div class="ev-tree ev-tree-left"></div>
                    <div class="ev-tree ev-tree-right"></div>

                    <div class="ev-house">
                        <div class="ev-house-roof"></div>
                        <div class="ev-house-body">
                            <div class="ev-house-window"></div>
                            <div class="ev-house-door"></div>
                            <div class="ev-house-window"></div>
                        </div>
                    </div>
                </div>
            </div>
        </aside>

        <main class="summary-main">
            <div class="summary-top">
                <a asp-controller="Home" asp-action="RoditeljHome" class="back-link">←</a>
                <h1>Pregled sažetka</h1>
            </div>

            <form method="get" asp-controller="SazetakAktivnosti" asp-action="RoditeljPregled" class="summary-filter">
                <div class="filter-item child-select-wrapper">
                    <label>Dijete</label>
                    <select name="dijeteId">
                        <option value="">— Odaberite dijete —</option>
                        @foreach (var dijete in Model.Djeca)
                        {
                            <option value="@dijete.Id" selected="@(Model.OdabraniDijeteId == dijete.Id)">
                                @dijete.ImePrezime
                            </option>
                        }
                    </select>
                </div>

                <div class="period-toggle">
                    <label class="period-option">
                        <input type="radio"
                               name="period"
                               value="Sedmica"
                               @(Model.Period == "Sedmica" ? "checked" : "") />
                        <span>Sedmica</span>
                    </label>

                    <label class="period-option">
                        <input type="radio"
                               name="period"
                               value="Mjesec"
                               @(Model.Period == "Mjesec" ? "checked" : "") />
                        <span>Mjesec</span>
                    </label>
                </div>

                <div class="filter-row">
                    <div class="filter-item period-select-wrapper" id="sedmicaWrapper">
                        <label>Sedmica</label>
                        <select id="sedmicaSelect" name="pocetak">
                            @foreach (var sedmica in Model.SedmicneOpcije)
                            {
                                <option value="@sedmica.Vrijednost"
                                        selected="@(Model.Period == "Sedmica" && Model.DatumPocetka.ToString("yyyy-MM-dd") == sedmica.Vrijednost)">
                                    @sedmica.Tekst
                                </option>
                            }
                        </select>
                    </div>

                    <div class="filter-item period-select-wrapper" id="mjesecWrapper">
                        <label>Mjesec</label>
                        <select id="mjesecSelect">
                            @foreach (var mjesec in Model.MjesecneOpcije)
                            {
                                <option value="@mjesec.Vrijednost"
                                        selected="@(Model.Period == "Mjesec" && Model.DatumPocetka.ToString("yyyy-MM-dd") == mjesec.Vrijednost)">
                                    @mjesec.Tekst
                                </option>
                            }
                        </select>
                    </div>

                    <button type="submit" class="filter-button">Prikaži</button>
                </div>
            </form>

            @if (!Model.Djeca.Any())
            {
                <section class="empty-box">
                    <h3>Trenutno nemate povezano dijete.</h3>
                    <p>Sažetak će biti dostupan kada administrator poveže dijete sa vašim nalogom.</p>
                </section>
            }
            else if (Model.Dijete == null)
            {
                <section class="empty-box">
                    <h3>Odaberite dijete za pregled sažetka.</h3>
                    <p>Sažetak se neće prikazivati dok ne izaberete pojedinačno dijete.</p>
                </section>
            }
            else
            {
                <section class="child-box">
                    <div class="child-avatar">🧒</div>

                    <div>
                        <h2>@Model.Dijete.ImePrezime</h2>
                        <p>Grupa: @(Model.Dijete.Grupa?.ImeGrupe ?? "Nije dodijeljena")</p>
                        <span class="period-label">
                            @Model.DatumPocetka.ToString("dd.MM.yyyy.") - @Model.DatumKraja.ToString("dd.MM.yyyy.")
                        </span>
                    </div>
                </section>

                <section class="stats-grid">
                    <div class="stat-box">
                        <div class="stat-heading">
                            <span class="stat-icon green">↓</span>
                            <h3>Dolasci</h3>
                        </div>

                        <div class="stat-number">@Model.BrojDolazaka</div>
                        <p>evidentiranih dolazaka</p>
                    </div>

                    <div class="stat-box">
                        <div class="stat-heading">
                            <span class="stat-icon blue">↑</span>
                            <h3>Odlasci</h3>
                        </div>

                        <div class="stat-number">@Model.BrojOdlazaka</div>
                        <p>evidentiranih odlazaka</p>
                    </div>

                    <div class="stat-box sleep-box">
                        <div class="stat-heading">
                            <span class="stat-icon blue">☾</span>
                            <h3>Spavanje</h3>
                        </div>

                        <p class="summary-sentence">@Model.OcjenaSpavanja</p>
                    </div>
                </section>

                <section class="meal-summary-grid">
                    <div class="meal-box">
                        <h3>🍽️ Doručak</h3>
                        <p>@Model.OcjenaDorucka</p>
                        <span>@Model.BrojDorucaka evidentiranih doručaka</span>
                    </div>

                    <div class="meal-box">
                        <h3>🍲 Ručak</h3>
                        <p>@Model.OcjenaRucka</p>
                        <span>@Model.BrojRucaka evidentiranih ručkova</span>
                    </div>
                </section>

                <section class="note-box">
                    <h3>Napomene po datumima</h3>

                    @if (!Model.NapomenePoDatumima.Any())
                    {
                        <p>Nema napomena za odabrani period.</p>
                    }
                    else
                    {
                        <div class="note-list">
                            @foreach (var napomena in Model.NapomenePoDatumima)
                            {
                                <div class="note-row">
                                    <strong>@napomena.Datum.ToString("dd.MM.yyyy.")</strong>
                                    <p>@napomena.Tekst</p>
                                </div>
                            }
                        </div>
                    }
                </section>
            }

            <nav class="bottom-menu">
                <a asp-controller="Home" asp-action="RoditeljHome">
                    <span>🏠</span> Početna
                </a>

                <a asp-controller="DnevniIzvjestaj" asp-action="RoditeljPregled">
                    <span>📋</span> Izvještaji
                </a>

                <a class="active" asp-controller="SazetakAktivnosti" asp-action="RoditeljPregled">
                    <span>📊</span> Sažeci
                </a>

                <a asp-controller="Obavijest" asp-action="RoditeljPregled">
                    <span>🔔</span> Obavijesti
                </a>

                <a asp-controller="Roditelj" asp-action="MojProfil">
                    <span>👤</span> Profil
                </a>
            </nav>
        </main>

    </div>
</div>

<style>
    body {
        background: #eaf6ff !important;
    }

    .summary-page {
        min-height: 100vh;
        padding: 22px 0;
        font-family: Arial, sans-serif;
        color: #071733;
    }

    .summary-card-layout {
        width: 100%;
        max-width: 1250px;
        min-height: 760px;
        margin: 0 auto;
        background: #fff;
        border-radius: 22px;
        box-shadow: 0 8px 26px rgba(15, 23, 42, 0.08);
        display: grid;
        grid-template-columns: 235px 1fr;
        overflow: hidden;
    }

    .summary-sidebar {
        background: #ffffff;
        border-right: 1px solid #eef2f7;
        padding: 28px 22px 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        min-width: 0;
    }

    .sidebar-logo {
        margin: 0 0 34px;
        color: #15913a;
        font-size: 2.65rem;
        line-height: 1;
        font-weight: 900;
        text-align: center;
    }

    .sidebar-menu {
        display: flex;
        flex-direction: column;
        gap: 12px;
        position: relative;
        z-index: 5;
    }

    .sidebar-link {
        min-height: 54px;
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 0 18px;
        border-radius: 12px;
        color: #0f172a;
        text-decoration: none;
        font-size: 1rem;
        font-weight: 800;
        box-sizing: border-box;
    }

    .sidebar-link:hover {
        color: #15803d;
        background: #edf8e9;
        text-decoration: none;
    }

    .sidebar-link span {
        width: 24px;
        text-align: center;
        font-size: 1.25rem;
        line-height: 1;
        flex-shrink: 0;
    }

    .sidebar-link.active {
        color: #15803d;
        background: #edf8e9;
    }

    .ev-sidebar-illustration {
        margin-top: auto;
        position: relative;
        width: calc(100% + 44px);
        margin-left: -22px;
        height: 230px;
        overflow: hidden;
        flex-shrink: 0;
        pointer-events: none;
    }

    .ev-cloud {
        position: absolute;
        background: #dff1ff;
        border-radius: 999px;
        z-index: 1;
    }

    .ev-cloud::before,
    .ev-cloud::after {
        content: "";
        position: absolute;
        background: #dff1ff;
        border-radius: 50%;
    }

    .ev-cloud-left {
        width: 52px;
        height: 14px;
        left: 60px;
        top: 50px;
    }

    .ev-cloud-left::before {
        width: 22px;
        height: 22px;
        left: 7px;
        top: -12px;
    }

    .ev-cloud-left::after {
        width: 20px;
        height: 20px;
        right: 7px;
        top: -10px;
    }

    .ev-cloud-right {
        width: 58px;
        height: 15px;
        right: 42px;
        top: 25px;
    }

    .ev-cloud-right::before {
        width: 24px;
        height: 24px;
        left: 12px;
        top: -14px;
    }

    .ev-cloud-right::after {
        width: 20px;
        height: 20px;
        right: 7px;
        top: -10px;
    }

    .ev-yard {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 145px;
        background: #96d93a;
        border-top-left-radius: 52px;
        border-top-right-radius: 52px;
        z-index: 2;
    }

    .ev-house {
        position: absolute;
        left: 50%;
        bottom: 38px;
        transform: translateX(-50%);
        width: 126px;
        height: 108px;
        z-index: 5;
    }

    .ev-house-roof {
        position: absolute;
        left: 50%;
        top: 0;
        transform: translateX(-50%);
        width: 0;
        height: 0;
        border-left: 60px solid transparent;
        border-right: 60px solid transparent;
        border-bottom: 48px solid #ff7d2b;
        z-index: 7;
    }

    .ev-house-body {
        position: absolute;
        left: 50%;
        bottom: 0;
        transform: translateX(-50%);
        width: 108px;
        height: 66px;
        background: #ffd166;
        border-radius: 7px 7px 0 0;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        gap: 12px;
        padding: 0 10px 11px;
        box-sizing: border-box;
        z-index: 6;
    }

    .ev-house-window {
        width: 18px;
        height: 24px;
        background: #5fc0ef;
        border-radius: 5px;
        margin-bottom: 3px;
    }

    .ev-house-door {
        width: 24px;
        height: 40px;
        background: #29a34a;
        border-radius: 9px 9px 0 0;
    }

    .ev-tree {
        position: absolute;
        bottom: 16px;
        width: 36px;
        height: 68px;
        background: #82bf3a;
        border-radius: 999px;
        z-index: 4;
    }

    .ev-tree::after {
        content: "";
        position: absolute;
        left: 50%;
        bottom: -43px;
        transform: translateX(-50%);
        width: 4px;
        height: 58px;
        background: #9b5f2f;
        border-radius: 999px;
    }

    .ev-tree-left {
        left: 38px;
    }

    .ev-tree-right {
        right: 38px;
    }

    .summary-main {
        grid-column: 2;
        padding: 38px 48px 0;
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .summary-top {
        display: flex;
        align-items: center;
        gap: 22px;
        margin-bottom: 26px;
    }

    .summary-top h1 {
        margin: 0;
        color: #0f172a;
        font-size: 2.15rem;
        font-weight: 900;
    }

    .back-link {
        color: #15803d;
        text-decoration: none;
        font-size: 2rem;
        line-height: 1;
    }

    .summary-filter {
        display: flex;
        flex-direction: column;
        gap: 18px;
        margin-bottom: 24px;
    }

    .period-toggle {
        display: flex;
        align-items: center;
        gap: 34px;
    }

    .period-option {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #0f172a;
        font-weight: 900;
        cursor: pointer;
    }

    .period-option input[type="radio"] {
        width: 21px;
        height: 21px;
        accent-color: #15803d;
    }

    .filter-row {
        display: grid;
        grid-template-columns: 1fr 1fr 140px;
        gap: 16px;
        align-items: end;
    }

    .child-select-wrapper {
        max-width: 420px;
    }

    .filter-item {
        display: flex;
        flex-direction: column;
        gap: 8px;
        min-width: 0;
    }

    .filter-item label {
        color: #0f172a;
        font-weight: 900;
        font-size: 0.95rem;
    }

    .filter-item select {
        width: 100%;
        height: 52px;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        background: #fff;
        padding: 0 14px;
        font-family: inherit;
        font-size: 1rem;
        color: #0f172a;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
    }

    .filter-button {
        height: 52px;
        border: none;
        border-radius: 12px;
        background: #15803d;
        color: white;
        font-size: 1rem;
        font-weight: 900;
        cursor: pointer;
        box-shadow: 0 10px 22px rgba(21, 128, 61, 0.18);
    }

    .filter-button:hover {
        background: #116c33;
    }

    .child-box,
    .stat-box,
    .note-box,
    .empty-box,
    .meal-box {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 18px rgba(15, 23, 42, 0.07);
    }

    .child-box {
        display: flex;
        align-items: center;
        gap: 24px;
        padding: 22px 26px;
        margin-bottom: 20px;
    }

    .child-avatar {
        width: 78px;
        height: 78px;
        border-radius: 50%;
        background: #dbeafe;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        flex-shrink: 0;
    }

    .child-box h2 {
        margin: 0 0 8px;
        font-size: 1.65rem;
        color: #0f172a;
        font-weight: 900;
    }

    .child-box p {
        margin: 0 0 6px;
        color: #475569;
        font-size: 1.05rem;
    }

    .period-label {
        color: #64748b;
        font-weight: 700;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 20px;
    }

    .stat-box {
        padding: 22px 26px;
        min-height: 158px;
    }

    .stat-heading {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .stat-heading h3 {
        margin: 0;
        color: #0f172a;
        font-size: 1.08rem;
        font-weight: 900;
    }

    .stat-icon {
        font-size: 1.25rem;
    }

    .stat-icon.green {
        color: #15803d;
    }

    .stat-icon.blue {
        color: #2563eb;
    }

    .stat-number {
        text-align: center;
        font-size: 3.2rem;
        line-height: 1;
        color: #0f172a;
        font-weight: 900;
        margin-top: 26px;
    }

    .stat-box p {
        text-align: center;
        color: #64748b;
        margin: 8px 0 0;
        font-size: 1rem;
    }

    .sleep-box {
        display: flex;
        flex-direction: column;
    }

    .summary-sentence {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        max-width: 230px;
        margin: 0 auto !important;
        text-align: center !important;
        color: #64748b !important;
        font-weight: 700;
        line-height: 1.45;
    }

    .meal-summary-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
        margin-bottom: 20px;
    }

    .meal-box {
        padding: 24px 28px;
        min-height: 140px;
    }

    .meal-box h3 {
        margin: 0 0 12px;
        color: #0f172a;
        font-size: 1.15rem;
        font-weight: 900;
    }

    .meal-box p {
        color: #334155;
        margin: 0 0 10px;
        line-height: 1.5;
        font-weight: 700;
    }

    .meal-box span {
        color: #64748b;
        font-size: 0.95rem;
    }

    .note-box {
        padding: 24px 28px;
        margin-bottom: 24px;
    }

    .note-box h3 {
        color: #c0560b;
        font-size: 1.25rem;
        font-weight: 900;
        margin: 0 0 14px;
    }

    .note-box p,
    .empty-box p {
        margin: 0;
        color: #0f172a;
        font-size: 1rem;
        line-height: 1.55;
        white-space: pre-line;
    }

    .note-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .note-row {
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 12px 14px;
        background: #f8fafc;
    }

    .note-row strong {
        display: block;
        margin-bottom: 6px;
        color: #15803d;
    }

    .empty-box {
        padding: 24px 28px;
        margin-bottom: 24px;
    }

    .empty-box h3 {
        margin: 0 0 8px;
        color: #0f172a;
        font-weight: 900;
    }

    .bottom-menu {
        margin-top: auto;
        min-height: 74px;
        border-top: 1px solid #e5e7eb;
        background: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 54px;
    }

    .bottom-menu a {
        display: flex;
        align-items: center;
        gap: 9px;
        text-decoration: none;
        color: #475569;
        font-weight: 800;
        font-size: 0.98rem;
        white-space: nowrap;
    }

    .bottom-menu a.active {
        color: #15803d;
    }

    @@media (max-width: 1200px) {
        .summary-card-layout {
            max-width: 100%;
            border-radius: 0;
            grid-template-columns: 220px 1fr;
        }

        .summary-main {
            padding: 32px 34px 0;
        }

        .filter-row {
            grid-template-columns: 1fr 1fr;
        }

        .filter-button {
            grid-column: 1 / -1;
        }

        .bottom-menu {
            gap: 26px;
        }
    }

    @@media (max-width: 900px) {
        .summary-card-layout {
            grid-template-columns: 1fr;
        }

        .summary-sidebar {
            display: none;
        }

        .summary-main {
            grid-column: 1;
        }

        .stats-grid,
        .meal-summary-grid,
        .filter-row {
            grid-template-columns: 1fr;
        }

        .child-select-wrapper {
            max-width: none;
        }

        .bottom-menu {
            gap: 18px;
            flex-wrap: wrap;
        }
    }
</style>

<script>
    function osvjeziPeriodPolja() {
        const odabraniPeriod = document.querySelector('input[name="period"]:checked')?.value || "Sedmica";

        const sedmicaWrapper = document.getElementById("sedmicaWrapper");
        const mjesecWrapper = document.getElementById("mjesecWrapper");

        const sedmicaSelect = document.getElementById("sedmicaSelect");
        const mjesecSelect = document.getElementById("mjesecSelect");

        if (odabraniPeriod === "Mjesec") {
            sedmicaWrapper.style.display = "none";
            mjesecWrapper.style.display = "flex";

            sedmicaSelect.removeAttribute("name");
            mjesecSelect.setAttribute("name", "pocetak");
        } else {
            sedmicaWrapper.style.display = "flex";
            mjesecWrapper.style.display = "none";

            mjesecSelect.removeAttribute("name");
            sedmicaSelect.setAttribute("name", "pocetak");
        }
    }

    document.querySelectorAll('input[name="period"]').forEach(radio => {
        radio.addEventListener("change", osvjeziPeriodPolja);
    });

    osvjeziPeriodPolja();
</script>
