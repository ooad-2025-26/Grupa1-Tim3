@model EVrtic.Models.Roditelj

@{
    ViewData["Title"] = "Detalji roditelja";
    Layout = "_AdminLayout";
}

<div class="details-page">
    <!-- Header sa strelicom za nazad -->
    <div class="details-header">
        <a asp-action="Index" asp-route-samoAktivne="@ViewBag.SamoAktivne" class="back-arrow">←</a>
        <h1>👨‍👩‍👧 Detalji roditelja</h1>
    </div>

    <!-- Profile card -->
    <div class="profile-card">
        <div class="profile-avatar">👨‍👩‍👧</div>
        <div class="profile-info">
            <h2>@Model.ImePrezime</h2>
            <div class="profile-details">
                <div class="detail-row">
                    <span class="detail-label">📧 Email:</span>
                    <span class="detail-value">@Model.Email</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">👶 Uloga:</span>
                    <span class="detail-value">@Model.Uloga</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">📊 Status naloga:</span>
                    @if (Model.StatusNaloga == StatusNaloga.AKTIVAN)
                    {
                        <span class="badge active">Aktivan</span>
                    }
                    else
                    {
                        <span class="badge inactive">Neaktivan</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Djeca roditelja -->
    <div class="section-card">
        <h3>👶 Djeca</h3>
        @if (Model.Djeca != null && Model.Djeca.Any())
        {
            <div class="children-list">
                @foreach (var dijete in Model.Djeca)
                {
                    <div class="child-item">
                        <div class="child-icon">🧒</div>
                        <div class="child-info">
                            <div class="child-name">@dijete.ImePrezime</div>
                            <div class="child-details">
                                <span class="child-group">🏫 Grupa: @(dijete.Grupa?.ImeGrupe ?? "Nije dodijeljen/a")</span>
                                <span class="child-status @(dijete.Aktivno ? "active" : "inactive")">
                                    @(dijete.Aktivno ? "Aktivno" : "Neaktivno")
                                </span>
                            </div>
                        </div>
                        <a asp-controller="Dijete" asp-action="Details" asp-route-id="@dijete.Id" class="child-link">→</a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-children">
                <span>👶</span>
                <p>Roditelj još nema povezane djece.</p>
                <a asp-controller="Dijete" asp-action="Create" class="btn-small">+ Dodaj dijete</a>
            </div>
        }
    </div>

    <!-- Akcije -->
    <div class="action-buttons">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-edit">✏️ Uredi podatke</a>
        <a asp-action="Index" asp-route-samoAktivne="@ViewBag.SamoAktivne" class="btn-back">← Povratak na listu</a>
    </div>
</div>

<style>
    .details-page {
        max-width: 900px;
        margin: 0 auto;
        padding: 30px 20px;
    }

    .details-header {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
    }

    .back-arrow {
        font-size: 2rem;
        text-decoration: none;
        color: #5f3bd8;
        transition: transform 0.2s;
        display: inline-block;
    }

        .back-arrow:hover {
            transform: translateX(-3px);
            color: #3b1e9e;
        }

    .details-header h1 {
        margin: 0;
        font-size: 1.8rem;
        color: #1e293b;
    }

    .profile-card {
        display: flex;
        gap: 24px;
        background: white;
        border-radius: 24px;
        padding: 28px;
        margin-bottom: 24px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        border: 1px solid #e2e8f0;
    }

    .profile-avatar {
        font-size: 4rem;
        background: #f1f5f9;
        border-radius: 50%;
        width: 90px;
        height: 90px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .profile-info {
        flex: 1;
    }

        .profile-info h2 {
            margin: 0 0 16px 0;
            font-size: 1.5rem;
            color: #0f172a;
        }

    .profile-details {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .detail-row {
        display: flex;
        align-items: baseline;
        gap: 12px;
        flex-wrap: wrap;
    }

    .detail-label {
        font-weight: 600;
        color: #64748b;
        min-width: 100px;
    }

    .detail-value {
        color: #1e293b;
    }

    .badge {
        padding: 4px 12px;
        border-radius: 40px;
        font-size: 0.75rem;
        font-weight: 600;
    }

        .badge.active {
            background: #dcfce7;
            color: #166534;
        }

        .badge.inactive {
            background: #fee2e2;
            color: #991b1b;
        }

    .section-card {
        background: white;
        border-radius: 24px;
        padding: 24px;
        margin-bottom: 24px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        border: 1px solid #e2e8f0;
    }

        .section-card h3 {
            margin: 0 0 20px 0;
            font-size: 1.2rem;
            color: #0f172a;
        }

    .children-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .child-item {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 14px;
        background: #f8fafc;
        border-radius: 16px;
        transition: all 0.2s;
    }

        .child-item:hover {
            background: #f1f5f9;
        }

    .child-icon {
        font-size: 2rem;
    }

    .child-info {
        flex: 1;
    }

    .child-name {
        font-weight: 700;
        font-size: 1rem;
        color: #0f172a;
        margin-bottom: 6px;
    }

    .child-details {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .child-group {
        font-size: 0.8rem;
        color: #64748b;
    }

    .child-status {
        font-size: 0.7rem;
        padding: 2px 10px;
        border-radius: 20px;
    }

        .child-status.active {
            background: #dcfce7;
            color: #166534;
        }

        .child-status.inactive {
            background: #fee2e2;
            color: #991b1b;
        }

    .child-link {
        font-size: 1.3rem;
        text-decoration: none;
        color: #5f3bd8;
        padding: 8px;
        border-radius: 8px;
        transition: background 0.2s;
    }

        .child-link:hover {
            background: #e2e8f0;
        }

    .empty-children {
        text-align: center;
        padding: 40px 20px;
        color: #64748b;
    }

        .empty-children span {
            font-size: 3rem;
            display: block;
            margin-bottom: 12px;
        }

    .btn-small {
        display: inline-block;
        margin-top: 12px;
        padding: 8px 16px;
        background: #5f3bd8;
        color: white;
        text-decoration: none;
        border-radius: 8px;
        font-size: 0.85rem;
    }

    .action-buttons {
        display: flex;
        gap: 16px;
        margin-top: 8px;
    }

    .btn-edit {
        background: #5f3bd8;
        color: white;
        padding: 10px 24px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        transition: background 0.2s;
    }

        .btn-edit:hover {
            background: #4a2eb5;
        }

    .btn-back {
        background: #f1f5f9;
        color: #475569;
        padding: 10px 24px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        transition: background 0.2s;
    }

        .btn-back:hover {
            background: #e2e8f0;
        }
</style>