@model EVrtic.Controllers.OdgajateljEvidencijaPregledViewModel

@{
    ViewData["Title"] = "Dolazak / Odlazak";
}

@functions {
    string FormatStatus(EVrtic.Models.StatusEvidencije status)
    {
        return status.ToString().Replace("_", " ").ToLower();
    }
}

<div class="educator-attendance-page">
    <div class="educator-attendance-card">

        <aside class="educator-sidebar">
            <h1 class="educator-logo">eVrtić</h1>

            <nav class="educator-menu">
    <a class="educator-link" asp-controller="Home" asp-action="OdgajateljHome">
        <span>🏠</span>
        Početna
    </a>

    <a class="educator-link" asp-controller="DnevniIzvjestaj" asp-action="EvidencijaAktivnosti">
        <span>📝</span>
        Aktivnosti
    </a>

    <a class="educator-link active" asp-controller="EvidencijaDolaskaOdlaska" asp-action="OdgajateljPregled">
        <span>☑️</span>
        Dolazak/Odlazak
    </a>

    <a class="educator-link" asp-controller="Obavijest" asp-action="OdgajateljObavijesti">
        <span>🔔</span>
        Obavijesti
    </a>

    <a class="educator-link" asp-controller="SazetakAktivnosti" asp-action="OdgajateljPregled">
        <span>📊</span>
        Sažeci
    </a>

    <a class="educator-link" asp-controller="Korisnik" asp-action="Profil">
        <span>👤</span>
        Profil
    </a>

    <form class="educator-logout-form"
          asp-area="Identity"
          asp-page="/Account/Logout"
          asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
          method="post">
        <button type="submit" class="educator-logout-button">
            <span class="logout-icon">🚪</span>
            <span class="logout-text">Odjava</span>
        </button>
    </form>
</nav>

            <div class="sidebar-decoration">
                <div class="cloud cloud-left"></div>
                <div class="cloud cloud-right"></div>

                <div class="ground-illustration">
                    <div class="tree tree-left"><div class="tree-top"></div><div class="tree-trunk"></div></div>
                    <div class="tree tree-right"><div class="tree-top"></div><div class="tree-trunk"></div></div>

                    <div class="house-illustration">
                        <div class="house-roof"></div>
                        <div class="house-body">
                            <div class="house-window"></div>
                            <div class="house-door"></div>
                            <div class="house-window"></div>
                        </div>
                    </div>
                </div>
            </div>
        </aside>

        <main class="educator-main">
            <div class="page-top">
                <div class="title-row">
                    <a asp-controller="Home" asp-action="OdgajateljHome" class="back-link">←</a>
                    <h1>Dolazak / Odlazak</h1>
                </div>
                <div class="qr-corner">▦</div>
            </div>

            <section class="intro-card">
                <div class="intro-icon">▦</div>
                <div>
                    <h2>Pregled evidencije dolaska i odlaska</h2>
                    <p>Pregledajte evidentirane dolaske i odlaske za djecu iz vaših grupa.</p>
                </div>
            </section>

            <form class="attendance-filter" method="get" asp-action="OdgajateljPregled">
                <div class="field-block">
                    <label>Datum</label>
                    <div class="date-box">
                        <span>@Model.Datum.ToString("dd.MM.yyyy.")</span>
                        <span class="calendar-symbol">▣</span>
                        <input type="date" name="datum" value="@Model.Datum.ToString("yyyy-MM-dd")" />
                    </div>
                </div>

                <div class="field-block">
                    <label>Grupa</label>
                    <select name="grupaId">
                        <option value="">Sve grupe</option>
                        @foreach (var grupa in Model.Grupe)
                        {
                            <option value="@grupa.Id" selected="@(grupa.Id == Model.OdabranaGrupaId ? "selected" : null)">
                                @grupa.ImeGrupe
                            </option>
                        }
                    </select>
                </div>

                <div class="field-block">
                    <label>Dijete</label>
                    <select name="dijeteId">
                        <option value="">Sva djeca</option>
                        @foreach (var dijete in Model.Djeca)
                        {
                            <option value="@dijete.Id" selected="@(dijete.Id == Model.OdabranoDijeteId ? "selected" : null)">
                                @dijete.ImePrezime
                            </option>
                        }
                    </select>
                </div>

                <button type="submit">Prikaži</button>
            </form>

            <section class="stats-grid">
                <div class="stat-card">
                    <span class="stat-icon green">↓</span>
                    <h3>Dolasci</h3>
                    <strong>@Model.BrojDolazaka</strong>
                </div>

                <div class="stat-card">
                    <span class="stat-icon purple">↑</span>
                    <h3>Odlasci</h3>
                    <strong>@Model.BrojOdlazaka</strong>
                </div>

                <div class="stat-card">
                    <span class="stat-icon red">!</span>
                    <h3>Odbijeno</h3>
                    <strong>@Model.BrojOdbijenih</strong>
                </div>
            </section>

            <section class="records-card">
                <div class="records-heading">
                    <h2>Evidencije za @Model.Datum.ToString("dd.MM.yyyy.")</h2>
                    <span>@Model.Evidencije.Count zapisa</span>
                </div>

                @if (!Model.Evidencije.Any())
                {
                    <div class="empty-state">
                        <div>▦</div>
                        <h3>Nema evidentiranih dolazaka ili odlazaka.</h3>
                        <p>Kada roditelj unese kod djeteta nakon skeniranja QR koda, zapis će se prikazati ovdje.</p>
                    </div>
                }
                else
                {
                    <div class="records-list">
                        @foreach (var evidencija in Model.Evidencije)
                        {
                            bool dolazak = evidencija.TipDogadjaja == EVrtic.Models.TipDogadjaja.DOLAZAK;
                            bool odbijeno = evidencija.StatusEvidencije == EVrtic.Models.StatusEvidencije.ODBIJENO;

                            <article class="record-item @(odbijeno ? "rejected" : "")">
                                <div class="record-icon @(dolazak ? "arrival" : "departure")">
                                    @(dolazak ? "↓" : "↑")
                                </div>

                                <div class="record-main">
                                    <h3>@(evidencija.Dijete?.ImePrezime ?? "Nepoznato dijete")</h3>
                                    <p>
                                        @(evidencija.Dijete?.Grupa?.ImeGrupe ?? "Bez grupe")
                                        · Kod: @evidencija.UneseniKodDjeteta
                                    </p>
                                </div>

                                <div class="record-meta">
                                    <strong>@evidencija.TipDogadjaja</strong>
                                    <span>@evidencija.VrijemeDogadjaja.ToString("HH:mm")</span>
                                </div>

                                <div class="record-status @(odbijeno ? "bad" : "good")">
                                    @FormatStatus(evidencija.StatusEvidencije)
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>

           <nav class="educator-bottom-nav">
    <a class="bottom-link" asp-controller="Home" asp-action="OdgajateljHome"><span>🏠</span> Početna</a>
    <a class="bottom-link" asp-controller="DnevniIzvjestaj" asp-action="EvidencijaAktivnosti"><span>📝</span> Aktivnosti</a>
    <a class="bottom-link" asp-controller="Obavijest" asp-action="OdgajateljObavijesti"><span>🔔</span> Obavijesti</a>
    <a class="bottom-link" asp-controller="Korisnik" asp-action="Profil"><span>👤</span> Profil</a>
</nav>
        </main>
    </div>
</div>

<style>
    body { background: #eef3ff; }

    .educator-attendance-page {
        min-height: 100vh;
        padding: 22px 0;
        font-family: Arial, sans-serif;
        color: #111827;
    }

    .educator-attendance-card {
        width: 100%;
        max-width: 1250px;
        min-height: 760px;
        margin: 0 auto;
        background: #f7f8ff;
        border-radius: 22px;
        box-shadow: 0 8px 26px rgba(15, 23, 42, 0.08);
        display: grid;
        grid-template-columns: 235px 1fr;
        overflow: hidden;
    }

    .educator-sidebar {
        background: #fff;
        border-right: 1px solid #e5e7eb;
        padding: 28px 22px 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .educator-logo {
        margin: 0 0 34px;
        color: #6243db;
        font-size: 2.7rem;
        font-weight: 900;
        text-align: center;
    }

    .educator-menu {
        display: flex;
        flex-direction: column;
        gap: 12px;
        z-index: 5;
    }

    .educator-link {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 18px;
        border-radius: 12px;
        color: #111827;
        text-decoration: none;
        font-size: 1rem;
        font-weight: 700;
    }

    .educator-link span {
        width: 24px;
        color: #334155;
        text-align: center;
        font-size: 1.25rem;
    }

    .educator-link.active {
        color: #6243db;
        background: #ece9ff;
    }

    .educator-link.active span { color: #6243db; }

    .sidebar-decoration {
        margin-top: auto;
        position: relative;
        width: calc(100% + 44px);
        margin-left: -22px;
        height: 230px;
        overflow: hidden;
    }

    .cloud {
        position: absolute;
        background: #dbeafe;
        border-radius: 50px;
        z-index: 1;
    }

    .cloud::before, .cloud::after {
        content: "";
        position: absolute;
        background: #dbeafe;
        border-radius: 50%;
    }

    .cloud-left { width: 56px; height: 18px; left: 48px; top: 22px; }
    .cloud-left::before { width: 20px; height: 20px; left: 8px; top: -10px; }
    .cloud-left::after { width: 24px; height: 24px; left: 26px; top: -12px; }
    .cloud-right { width: 62px; height: 20px; right: 48px; top: 8px; }
    .cloud-right::before { width: 22px; height: 22px; left: 8px; top: -10px; }
    .cloud-right::after { width: 26px; height: 26px; left: 28px; top: -13px; }

    .ground-illustration {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 150px;
        background: #98c943;
        border-top-left-radius: 42px;
        border-top-right-radius: 42px;
        z-index: 2;
    }

    .house-illustration {
        position: absolute;
        left: 50%;
        bottom: 26px;
        transform: translateX(-50%);
        width: 132px;
        height: 105px;
        z-index: 4;
    }

    .house-roof {
        position: absolute;
        left: 50%;
        top: 0;
        transform: translateX(-50%);
        width: 112px;
        height: 42px;
        background: #6243db;
        clip-path: polygon(50% 0%, 100% 100%, 0% 100%);
        z-index: 5;
    }

    .house-body {
        position: absolute;
        left: 50%;
        bottom: 0;
        transform: translateX(-50%);
        width: 104px;
        height: 62px;
        background: #ffd166;
        border-radius: 6px;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        gap: 12px;
        padding-bottom: 12px;
        z-index: 4;
    }

    .house-window { width: 16px; height: 24px; background: #5fc0ef; border-radius: 4px; margin-bottom: 2px; }
    .house-door { width: 20px; height: 34px; background: #6243db; border-radius: 8px 8px 0 0; }
    .tree { position: absolute; bottom: 16px; z-index: 3; }
    .tree-left { left: 42px; }
    .tree-right { right: 42px; }
    .tree-top { width: 30px; height: 64px; background: #8ac53a; border-radius: 20px; margin: 0 auto; }
    .tree-trunk { width: 4px; height: 62px; background: #9c5c2f; margin: -2px auto 0; border-radius: 3px; }

    .educator-main {
        padding: 34px 48px 0;
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .page-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 26px;
    }

    .title-row {
        display: flex;
        align-items: center;
        gap: 24px;
    }

    .back-link {
        color: #6243db;
        text-decoration: none;
        font-size: 2.2rem;
        line-height: 1;
    }

    .title-row h1 {
        margin: 0;
        font-size: 2.05rem;
        font-weight: 900;
        color: #111827;
    }

    .qr-corner {
        color: #6243db;
        font-size: 2rem;
        font-weight: 900;
    }

    .intro-card, .records-card, .stat-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 18px rgba(15, 23, 42, 0.07);
    }

    .intro-card {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 22px 26px;
        margin-bottom: 20px;
    }

    .intro-icon {
        width: 62px;
        height: 62px;
        border-radius: 16px;
        background: #ece9ff;
        color: #6243db;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        font-weight: 900;
        flex-shrink: 0;
    }

    .intro-card h2 { margin: 0 0 6px; font-size: 1.35rem; font-weight: 900; }
    .intro-card p { margin: 0; color: #64748b; }

    .attendance-filter {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 120px;
        gap: 16px;
        align-items: end;
        margin-bottom: 20px;
    }

    .field-block label {
        display: block;
        margin-bottom: 8px;
        color: #111827;
        font-weight: 900;
    }

    .field-block select,
    .date-box {
        width: 100%;
        height: 54px;
        border: 1px solid #d8def0;
        border-radius: 12px;
        background: #fff;
        padding: 0 14px;
        font-size: 1rem;
        color: #111827;
        box-sizing: border-box;
    }

    .date-box {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .date-box input[type="date"] {
        position: absolute;
        inset: 0;
        opacity: 0;
        cursor: pointer;
    }

    .calendar-symbol { color: #6243db; font-weight: 900; }

    .attendance-filter button {
        height: 54px;
        border: none;
        border-radius: 12px;
        background: #6243db;
        color: white;
        font-weight: 900;
        font-size: 1rem;
        cursor: pointer;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-bottom: 20px;
    }

    .stat-card {
        padding: 18px 22px;
        min-height: 130px;
    }

    .stat-icon {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 12px;
        font-weight: 900;
    }

    .stat-icon.green { color: #15803d; background: #dcfce7; }
    .stat-icon.purple { color: #6243db; background: #ece9ff; }
    .stat-icon.red { color: #dc2626; background: #fee2e2; }

    .stat-card h3 { margin: 0; font-size: 1rem; font-weight: 900; color: #111827; }
    .stat-card strong { display: block; margin-top: 14px; font-size: 2.4rem; color: #111827; }

    .records-card {
        padding: 24px;
        margin-bottom: 22px;
    }

    .records-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
    }

    .records-heading h2 { margin: 0; font-size: 1.35rem; font-weight: 900; }
    .records-heading span { color: #6243db; font-weight: 900; background: #ece9ff; padding: 8px 14px; border-radius: 999px; }

    .empty-state {
        text-align: center;
        padding: 36px 20px;
        color: #64748b;
    }

    .empty-state div { color: #6243db; font-size: 3rem; margin-bottom: 12px; }
    .empty-state h3 { margin: 0 0 8px; color: #111827; }
    .empty-state p { margin: 0; }

    .records-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .record-item {
        display: grid;
        grid-template-columns: 58px 1fr 120px 120px;
        gap: 16px;
        align-items: center;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 16px;
        background: #fff;
    }

    .record-item.rejected {
        border-color: #fecaca;
        background: #fff7f7;
    }

    .record-icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        font-weight: 900;
    }

    .record-icon.arrival { color: #15803d; background: #dcfce7; }
    .record-icon.departure { color: #6243db; background: #ece9ff; }

    .record-main h3 { margin: 0 0 4px; font-size: 1rem; font-weight: 900; }
    .record-main p { margin: 0; color: #64748b; font-size: .94rem; }

    .record-meta { text-align: right; }
    .record-meta strong { display: block; font-size: .9rem; color: #111827; }
    .record-meta span { color: #64748b; }

    .record-status {
        text-align: center;
        border-radius: 999px;
        padding: 8px 10px;
        font-weight: 900;
        font-size: .9rem;
        text-transform: capitalize;
    }

    .record-status.good { background: #dcfce7; color: #15803d; }
    .record-status.bad { background: #fee2e2; color: #dc2626; }

.educator-bottom-nav {
    margin-top: auto;
    min-height: 74px;
    border-top: 1px solid #e5e7eb;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 54px;
    background: #fff;
}

.bottom-link {
    display: flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    color: #475569;
    font-weight: 800;
    font-size: 0.98rem;
}

.bottom-link.active {
    color: #7447d8;
}

.bottom-link span {
    position: relative;
    font-size: 1.25rem;
}

    @@media (max-width: 800px) {
        .educator-attendance-card { grid-template-columns: 1fr; }
        .educator-sidebar { display: none; }
        .bottom-nav { gap: 20px; flex-wrap: wrap; }
    }

    .educator-logout-form {
    width: 100%;
    display: flex;
    justify-content: center;
    margin: 18px 0 0 0;
    position: relative;
    z-index: 20;
}

.educator-logout-button {
    width: 220px;
    height: 58px;
    border: 2px solid #111827;
    border-radius: 12px;
    background: #ffffff !important;
    color: #071733;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    cursor: pointer;
    padding: 0;
    box-shadow: none;
    line-height: 1;
}

.educator-logout-button .logout-icon {
    font-size: 1.15rem;
    line-height: 1;
}

.educator-logout-button .logout-text {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1;
}

.educator-logout-button:hover {
    background: #f8fafc !important;
}
</style>


