@model EVrtic.Models.Obavijest

@{
    ViewData["Title"] = "Detalji obavijesti";
    var datum = (Model.DatumSlanja ?? Model.DatumKreiranja).ToString("dd.MM.yyyy. HH:mm");
}

<div class="notification-detail-page">
    <div class="detail-card-layout">

        <aside class="detail-sidebar">
            <h1 class="sidebar-logo">eVrtić</h1>

            <nav class="sidebar-menu">
                <a class="sidebar-link" asp-controller="Home" asp-action="RoditeljHome">
                    <span>🏠</span> Početna
                </a>

                <a class="sidebar-link" asp-controller="DnevniIzvjestaj" asp-action="RoditeljPregled">
                    <span>📋</span> Izvještaji
                </a>

                <a class="sidebar-link" asp-controller="EvidencijaDolaskaOdlaska" asp-action="RoditeljEvidencija">
                    <span>🗓️</span> Dolazak/Odlazak
                </a>

                <a class="sidebar-link" asp-controller="SazetakAktivnosti" asp-action="RoditeljPregled">
                    <span>📊</span> Sažeci
                </a>

                <a class="sidebar-link active" asp-controller="Obavijest" asp-action="RoditeljPregled">
                    <span>🔔</span> Obavijesti
                </a>

                <a class="sidebar-link" asp-controller="Roditelj" asp-action="MojProfil">
                    <span>👤</span> Profil
                </a>
            </nav>
        </aside>

        <main class="detail-main">
            <div class="detail-top">
                <div class="title-row">
                    <a asp-controller="Obavijest" asp-action="RoditeljPregled" class="back-link">←</a>
                    <h1>Detalji obavijesti</h1>
                </div>
            </div>

            <section class="detail-card">
                <div class="detail-icon">🔔</div>

                <div class="detail-content">
                    <h2>@Model.Naslov</h2>

                    <div class="detail-meta">
                        <span>@datum</span>
                        <span>@Model.KanalSlanja</span>

                        @if (Model.Odgajatelj != null)
                        {
                            <span>Od: @Model.Odgajatelj.ImePrezime</span>
                        }
                    </div>

                    <p>@Model.Sadrzaj</p>
                </div>
            </section>

            <nav class="bottom-menu">
                <a asp-controller="Home" asp-action="RoditeljHome">
                    <span>🏠</span> Početna
                </a>

                <a asp-controller="DnevniIzvjestaj" asp-action="RoditeljPregled">
                    <span>📋</span> Izvještaji
                </a>

                <a asp-controller="SazetakAktivnosti" asp-action="RoditeljPregled">
                    <span>📊</span> Sažeci
                </a>

                <a class="active" asp-controller="Obavijest" asp-action="RoditeljPregled">
                    <span>🔔</span> Obavijesti
                </a>

                <a asp-controller="Roditelj" asp-action="MojProfil">
                    <span>👤</span> Profil
                </a>
            </nav>
        </main>
    </div>
</div>

<style>
    body {
        background: #eaf6ff;
    }

    .notification-detail-page {
        min-height: 100vh;
        padding: 22px 0;
        font-family: Arial, sans-serif;
    }

    .detail-card-layout {
        width: 100%;
        max-width: 1250px;
        min-height: 760px;
        margin: 0 auto;
        background: #fff;
        border-radius: 22px;
        box-shadow: 0 8px 26px rgba(15, 23, 42, 0.08);
        display: grid;
        grid-template-columns: 235px 1fr;
        overflow: hidden;
    }

    .detail-sidebar {
        position: relative;
        border-right: 1px solid #eef2f7;
        padding: 28px 22px 0;
        overflow: hidden;
    }

    .sidebar-logo {
        margin: 0 0 34px;
        color: #15913a;
        font-size: 2.65rem;
        font-weight: 800;
        text-align: center;
    }

    .sidebar-menu {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .sidebar-link {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 18px;
        border-radius: 12px;
        color: #0f172a;
        text-decoration: none;
        font-size: 1rem;
        font-weight: 700;
    }

    .sidebar-link span {
        width: 24px;
        text-align: center;
        font-size: 1.25rem;
    }

    .sidebar-link.active {
        color: #15803d;
        background: #edf8e9;
    }

    .detail-main {
        padding: 34px 48px 0;
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .detail-top {
        margin-bottom: 28px;
    }

    .title-row {
        display: flex;
        align-items: center;
        gap: 22px;
    }

    .title-row h1 {
        margin: 0;
        color: #0f172a;
        font-size: 2.05rem;
        font-weight: 800;
    }

    .back-link {
        color: #15803d;
        text-decoration: none;
        font-size: 2rem;
        line-height: 1;
    }

    .detail-card {
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 4px 18px rgba(15, 23, 42, 0.07);
        padding: 30px;
        display: flex;
        gap: 22px;
        margin-bottom: 24px;
    }

    .detail-icon {
        width: 62px;
        height: 62px;
        border-radius: 50%;
        background: #fff7ed;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        flex-shrink: 0;
    }

    .detail-content h2 {
        margin: 0 0 12px;
        color: #0f172a;
        font-size: 1.7rem;
        font-weight: 800;
    }

    .detail-meta {
        display: flex;
        gap: 18px;
        flex-wrap: wrap;
        color: #64748b;
        font-size: 0.95rem;
        margin-bottom: 22px;
    }

    .detail-content p {
        margin: 0;
        color: #0f172a;
        line-height: 1.7;
        font-size: 1.05rem;
        white-space: pre-line;
    }

    .bottom-menu {
        margin-top: auto;
        min-height: 74px;
        border-top: 1px solid #e5e7eb;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 50px;
    }

    .bottom-menu a {
        display: flex;
        align-items: center;
        gap: 9px;
        text-decoration: none;
        color: #475569;
        font-weight: 700;
        font-size: 0.98rem;
    }

    .bottom-menu a.active {
        color: #15803d;
    }

    @@media (max-width: 900px) {
        .detail-card-layout {
            grid-template-columns: 1fr;
        }

        .detail-sidebar {
            display: none;
        }

        .detail-card {
            flex-direction: column;
        }
    }
</style>