@model EVrtic.Controllers.RoditeljObavijestiViewModel

@{
    ViewData["Title"] = "Obavijesti";
}

<div class="notifications-page">
    <div class="notifications-card-layout">

        <aside class="notifications-sidebar">
            <h1 class="sidebar-logo">eVrtić</h1>

            <nav class="sidebar-menu">
                <a class="sidebar-link" asp-controller="Home" asp-action="RoditeljHome">
                    <span>🏠</span> Početna
                </a>

                <a class="sidebar-link" asp-controller="DnevniIzvjestaj" asp-action="RoditeljPregled">
                    <span>📋</span> Izvještaji
                </a>

                <a class="sidebar-link" asp-controller="EvidencijaDolaskaOdlaska" asp-action="RoditeljEvidencija">
                    <span>🗓️</span> Dolazak/Odlazak
                </a>

                <a class="sidebar-link" asp-controller="SazetakAktivnosti" asp-action="RoditeljPregled">
                    <span>📊</span> Sažeci
                </a>

                <a class="sidebar-link active" asp-controller="Obavijest" asp-action="RoditeljPregled">
                    <span>🔔</span> Obavijesti
                </a>

                <a class="sidebar-link" asp-controller="Roditelj" asp-action="MojProfil">
                    <span>👤</span> Profil
                </a>
            </nav>

            <div class="sidebar-decoration">
                <div class="cloud cloud-left"></div>
                <div class="cloud cloud-right"></div>

                <div class="ground-illustration">
                    <div class="tree tree-left">
                        <div class="tree-top"></div>
                        <div class="tree-trunk"></div>
                    </div>

                    <div class="tree tree-right">
                        <div class="tree-top"></div>
                        <div class="tree-trunk"></div>
                    </div>

                    <div class="house-illustration">
                        <div class="house-roof"></div>
                        <div class="house-body">
                            <div class="house-window"></div>
                            <div class="house-door"></div>
                            <div class="house-window"></div>
                        </div>
                    </div>
                </div>
            </div>
        </aside>

        <main class="notifications-main">
            <div class="notifications-top">
                <div class="title-row">
                    <a asp-controller="Home" asp-action="RoditeljHome" class="back-link">←</a>
                    <h1>Obavijesti</h1>
                </div>

                <div class="notification-counter">
                    @Model.BrojNovih novih
                </div>
            </div>

            @if (!Model.Obavijesti.Any())
            {
                <section class="empty-box">
                    <div class="empty-icon">🔔</div>
                    <h3>Trenutno nemate obavijesti.</h3>
                    <p>Kada odgajatelj ili administrator pošalje obavijest, prikazat će se ovdje.</p>
                </section>
            }
            else
            {
                <section class="notifications-list">
                    @foreach (var obavijest in Model.Obavijesti)
                    {
                     bool nova =
                       obavijest.StatusObavijesti == EVrtic.Models.StatusObavijesti.POSLANA ||
                       obavijest.StatusObavijesti == EVrtic.Models.StatusObavijesti.KREIRANA;

                        <a class="notification-card @(nova ? "unread" : "")"
                           asp-controller="Obavijest"
                           asp-action="RoditeljDetalji"
                           asp-route-id="@obavijest.Id">

                            <div class="notification-icon">🔔</div>

                            <div class="notification-content">
                                <div class="notification-heading">
                                    <h3>@obavijest.Naslov</h3>

                                    @if (nova)
                                    {
                                        <span class="new-badge">Novo</span>
                                    }
                                </div>
                            </div>

                            <div class="notification-arrow">→</div>
                        </a>
                    }
                </section>
            }

            <nav class="bottom-menu">
                <a asp-controller="Home" asp-action="RoditeljHome">
                    <span>🏠</span> Početna
                </a>

                <a asp-controller="DnevniIzvjestaj" asp-action="RoditeljPregled">
                    <span>📋</span> Izvještaji
                </a>

                <a asp-controller="SazetakAktivnosti" asp-action="RoditeljPregled">
                    <span>📊</span> Sažeci
                </a>

                <a class="active" asp-controller="Obavijest" asp-action="RoditeljPregled">
                    <span>🔔</span> Obavijesti
                </a>

                <a asp-controller="Roditelj" asp-action="MojProfil">
                    <span>👤</span> Profil
                </a>
            </nav>
        </main>
    </div>
</div>

<style>
    body {
        background: #eaf6ff;
    }

    .notifications-page {
        min-height: 100vh;
        padding: 22px 0;
        font-family: Arial, sans-serif;
    }

    .notifications-card-layout {
        width: 100%;
        max-width: 1250px;
        min-height: 760px;
        margin: 0 auto;
        background: #fff;
        border-radius: 22px;
        box-shadow: 0 8px 26px rgba(15, 23, 42, 0.08);
        display: grid;
        grid-template-columns: 235px 1fr;
        overflow: hidden;
    }

    .notifications-sidebar {
        position: relative;
        border-right: 1px solid #eef2f7;
        padding: 28px 22px 0;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .sidebar-logo {
        margin: 0 0 34px;
        color: #15913a;
        font-size: 2.65rem;
        font-weight: 800;
        text-align: center;
    }

    .sidebar-menu {
        display: flex;
        flex-direction: column;
        gap: 12px;
        position: relative;
        z-index: 5;
    }

    .sidebar-link {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 18px;
        border-radius: 12px;
        color: #0f172a;
        text-decoration: none;
        font-size: 1rem;
        font-weight: 700;
    }

    .sidebar-link span {
        width: 24px;
        text-align: center;
        font-size: 1.25rem;
    }

    .sidebar-link.active {
        color: #15803d;
        background: #edf8e9;
    }

    .sidebar-decoration {
        margin-top: auto;
        position: relative;
        width: calc(100% + 44px);
        margin-left: -22px;
        height: 230px;
        overflow: hidden;
    }

    .cloud {
        position: absolute;
        background: #d7e8f7;
        border-radius: 50px;
        z-index: 1;
    }

    .cloud::before,
    .cloud::after {
        content: "";
        position: absolute;
        background: #d7e8f7;
        border-radius: 50%;
    }

    .cloud-left {
        width: 56px;
        height: 18px;
        left: 48px;
        top: 22px;
    }

    .cloud-left::before {
        width: 20px;
        height: 20px;
        left: 8px;
        top: -10px;
    }

    .cloud-left::after {
        width: 24px;
        height: 24px;
        left: 26px;
        top: -12px;
    }

    .cloud-right {
        width: 62px;
        height: 20px;
        right: 48px;
        top: 8px;
    }

    .cloud-right::before {
        width: 22px;
        height: 22px;
        left: 8px;
        top: -10px;
    }

    .cloud-right::after {
        width: 26px;
        height: 26px;
        left: 28px;
        top: -13px;
    }

    .ground-illustration {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 150px;
        background: #9dd43a;
        border-top-left-radius: 42px;
        border-top-right-radius: 42px;
        z-index: 2;
    }

    .house-illustration {
        position: absolute;
        left: 50%;
        bottom: 26px;
        transform: translateX(-50%);
        width: 132px;
        height: 105px;
        z-index: 4;
    }

    .house-roof {
        position: absolute;
        left: 50%;
        top: 0;
        transform: translateX(-50%);
        width: 112px;
        height: 42px;
        background: #ff7d2b;
        clip-path: polygon(50% 0%, 100% 100%, 0% 100%);
        z-index: 5;
    }

    .house-body {
        position: absolute;
        left: 50%;
        bottom: 0;
        transform: translateX(-50%);
        width: 104px;
        height: 62px;
        background: #f4cf61;
        border-radius: 6px;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        gap: 12px;
        padding-bottom: 12px;
        z-index: 4;
    }

    .house-window {
        width: 16px;
        height: 24px;
        background: #5fc0ef;
        border-radius: 4px;
        margin-bottom: 2px;
    }

    .house-door {
        width: 20px;
        height: 34px;
        background: #2faa47;
        border-radius: 8px 8px 0 0;
    }

    .tree {
        position: absolute;
        bottom: 16px;
        z-index: 3;
    }

    .tree-left {
        left: 42px;
    }

    .tree-right {
        right: 42px;
    }

    .tree-top {
        width: 30px;
        height: 64px;
        background: #8ac53a;
        border-radius: 20px;
        margin: 0 auto;
    }

    .tree-trunk {
        width: 4px;
        height: 62px;
        background: #9c5c2f;
        margin: -2px auto 0 auto;
        border-radius: 3px;
    }

    .notifications-main {
        padding: 34px 48px 0;
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .notifications-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 28px;
    }

    .title-row {
        display: flex;
        align-items: center;
        gap: 22px;
    }

    .title-row h1 {
        margin: 0;
        color: #0f172a;
        font-size: 2.05rem;
        font-weight: 800;
    }

    .back-link {
        color: #15803d;
        text-decoration: none;
        font-size: 2rem;
        line-height: 1;
    }

    .notification-counter {
        background: #edf8e9;
        color: #15803d;
        font-weight: 800;
        border-radius: 999px;
        padding: 10px 18px;
    }

    .notifications-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
        margin-bottom: 24px;
    }

    .notification-card,
    .empty-box {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 18px rgba(15, 23, 42, 0.07);
    }

    .notification-card {
        display: grid;
        grid-template-columns: 64px 1fr 30px;
        gap: 18px;
        align-items: center;
        padding: 20px 24px;
        color: inherit;
        text-decoration: none;
        border: 2px solid transparent;
    }

   .notification-card.unread {
    border-color: #fecaca;
    background: #fff7f7;
    box-shadow: 0 6px 22px rgba(239, 68, 68, 0.10);
}

    .notification-icon {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: #fff7ed;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.7rem;
    }

    .notification-heading {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 0;
    }

    .notification-heading h3 {
        margin: 0;
        color: #0f172a;
        font-size: 1.15rem;
        font-weight: 800;
    }

    .new-badge {
         background: #ef4444;
         color: white;
         border-radius: 999px;
         padding: 4px 10px;
         font-size: 0.78rem;
         font-weight: 900;
}

    .notification-content p {
        margin: 0 0 10px;
        color: #475569;
        line-height: 1.45;
    }

    .notification-meta {
        display: flex;
        gap: 18px;
        color: #64748b;
        font-size: 0.9rem;
        flex-wrap: wrap;
    }

    .notification-arrow {
        color: #2563eb;
        font-size: 1.5rem;
        font-weight: 900;
    }

    .empty-box {
        padding: 48px 28px;
        text-align: center;
    }

    .empty-icon {
        font-size: 3rem;
        margin-bottom: 12px;
    }

    .empty-box h3 {
        margin: 0 0 8px;
        color: #0f172a;
        font-size: 1.35rem;
    }

    .empty-box p {
        margin: 0;
        color: #64748b;
    }

    .bottom-menu {
        margin-top: auto;
        min-height: 74px;
        border-top: 1px solid #e5e7eb;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 50px;
    }

    .bottom-menu a {
        display: flex;
        align-items: center;
        gap: 9px;
        text-decoration: none;
        color: #475569;
        font-weight: 700;
        font-size: 0.98rem;
    }

    .bottom-menu a.active {
        color: #15803d;
    }

    @@media (max-width: 1200px) {
        .notifications-card-layout {
            max-width: 100%;
            border-radius: 0;
            grid-template-columns: 220px 1fr;
        }

        .notifications-main {
            padding: 32px 34px 0;
        }

        .bottom-menu {
            gap: 24px;
        }
    }

    @@media (max-width: 900px) {
        .notifications-card-layout {
            grid-template-columns: 1fr;
        }

        .notifications-sidebar {
            display: none;
        }

        .notification-card {
            grid-template-columns: 54px 1fr;
        }

        .notification-arrow {
            display: none;
        }
    }
</style>