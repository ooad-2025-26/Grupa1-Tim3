@model EVrtic.Controllers.EvidencijaAktivnostiViewModel
@using EVrtic.Models

@{
    ViewData["Title"] = "Evidencija aktivnosti";

    string SpavaStart = Model.PostojeciIzvjestaj?.VrijemeDolaska.HasValue == true
        ? Model.PostojeciIzvjestaj.VrijemeDolaska!.Value.ToString(@"hh\:mm") : "";
    string SpavaEnd = Model.PostojeciIzvjestaj?.VrijemeOdlaska.HasValue == true
        ? Model.PostojeciIzvjestaj.VrijemeOdlaska!.Value.ToString(@"hh\:mm") : "";
    string Napomena = Model.PostojeciIzvjestaj?.NapomenaAktivnosti ?? "";

    var statusi = new[]
    {
        new { Val = (int)StatusObroka.NIJE_POJEDENO,       Tekst = "Nije pojedeno" },
        new { Val = (int)StatusObroka.DJELIMICNO_POJEDENO, Tekst = "Djelimično pojedeno" },
        new { Val = (int)StatusObroka.POTPUNO_POJEDENO,    Tekst = "Potpuno pojedeno" }
    };

    var obrociDef = new[]
    {
        new {
            Naziv = "🥣 Doručak", TekstName = "DorucakTekst", StatusName = "StatusDorucka",
            Tekst = Model.DorucakTekst, StatusVal = Model.StatusDoruckaVal,
            Placeholder = "Šta se jelo za doručak?"
        },
        new {
            Naziv = "🍲 Ručak", TekstName = "RucakTekst", StatusName = "StatusRucka",
            Tekst = Model.RucakTekst, StatusVal = Model.StatusRuckaVal,
            Placeholder = "Šta se jelo za ručak?"
        }
    };
}

<div class="educator-page">
    <div class="educator-card">

        <aside class="educator-sidebar">
            <h1 class="educator-logo">eVrtić</h1>
         <nav class="educator-menu">
    <a class="educator-link" asp-controller="Home" asp-action="OdgajateljHome">
        <span>🏠</span>
        Početna
    </a>

    <a class="educator-link active" asp-controller="DnevniIzvjestaj" asp-action="EvidencijaAktivnosti">
        <span>📝</span>
        Aktivnosti
    </a>

    <a class="educator-link" asp-controller="EvidencijaDolaskaOdlaska" asp-action="OdgajateljPregled">
        <span>☑️</span>
        Dolazak/Odlazak
    </a>

    <a class="educator-link" asp-controller="Obavijest" asp-action="OdgajateljObavijesti">
        <span>🔔</span>
        Obavijesti
    </a>

    <a class="educator-link" asp-controller="SazetakAktivnosti" asp-action="OdgajateljPregled">
        <span>📊</span>
        Sažeci
    </a>

    <a class="educator-link" asp-controller="Korisnik" asp-action="Profil">
        <span>👤</span>
        Profil
    </a>

   
</nav>
            <div class="educator-side-art">
                <div class="side-cloud side-cloud-1"></div>
                <div class="side-cloud side-cloud-2"></div>
                <div class="side-kindergarten">
                    <div class="side-roof"></div>
                    <div class="side-building">
                        <div class="side-window"></div>
                        <div class="side-door"></div>
                        <div class="side-window"></div>
                    </div>
                </div>
                <div class="side-tree side-tree-left"></div>
                <div class="side-tree side-tree-right"></div>
            </div>
        </aside>

        <main class="educator-main educator-main-scroll">
            <div class="ev-header">
                <h1 class="edu-page-title">Evidencija aktivnosti</h1>
                <span class="ev-calendar-icon">📅</span>
            </div>

            @if (TempData["Uspjeh"] != null)
            {
                <div class="edu-flash-ok">✅ @TempData["Uspjeh"]</div>
            }

            @if (TempData["Greska"] != null)
            {
                <div class="edu-flash-error">⚠️ @TempData["Greska"]</div>
            }

            <form asp-action="SacuvajAktivnosti" method="post" class="ev-form" id="evForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Datum" value="@Model.Datum.ToString("yyyy-MM-dd")" />

                @* ── Odabir djeteta ── *@
                <div class="ev-field">
                    <label class="ev-label">Dijete</label>
                    <div class="ev-select-wrap">
                        <div class="ev-select-avatar">👧</div>
                        <select name="DijeteId" id="dijeteSelect" class="ev-select"
                                onchange="updateDijete(this.value)">
                            <option value="">— Odaberite dijete —</option>
                            @{
                                var grupeDjece = Model.Djeca
                                    .GroupBy(d => d.Grupa?.ImeGrupe ?? "Bez grupe")
                                    .OrderBy(g => g.Key)
                                    .ToList();
                            }
                            @if (grupeDjece.Count <= 1)
                            {
                                foreach (var d in Model.Djeca)
                                {
                                    if (Model.OdabraniDijeteId == d.Id)
                                    {
                                        <option value="@d.Id" selected>@d.ImePrezime</option>
                                    }
                                    else
                                    {
                                        <option value="@d.Id">@d.ImePrezime</option>
                                    }
                                }
                            }
                            else
                            {
                                foreach (var grupa in grupeDjece)
                                {
                                    <optgroup label="@grupa.Key">
                                        @foreach (var d in grupa.OrderBy(x => x.ImePrezime))
                                        {
                                            if (Model.OdabraniDijeteId == d.Id)
                                            {
                                                <option value="@d.Id" selected>@d.ImePrezime</option>
                                            }
                                            else
                                            {
                                                <option value="@d.Id">@d.ImePrezime</option>
                                            }
                                        }
                                    </optgroup>
                                }
                            }
                        </select>
                        <span class="ev-chevron">▾</span>
                    </div>
                </div>

                @* ── Datum ── *@
                <div class="ev-field">
                    <label class="ev-label">Datum</label>
                    <div class="ev-date-wrap">
                        <input type="date" id="datumInput" class="ev-date-input"
                               value="@Model.Datum.ToString("yyyy-MM-dd")"
                               onchange="updateDatum(this.value)" />
                        <span class="ev-date-icon">📅</span>
                    </div>
                </div>

                @if (Model.OdabraniDijeteId.HasValue)
                {
                    @if (!Model.MozeUnositiAktivnosti)
                    {
                        <div class="edu-flash-error">
                            ⚠️ @Model.PorukaZakljucavanja
                        </div>
                    }

                    <fieldset disabled="@(!Model.MozeUnositiAktivnosti)" class="ev-locked-fieldset">
                        @* ── Obroci (Doručak i Ručak): tekst + status ── *@
                        <div class="ev-field">
                            <label class="ev-label">Obroci</label>
                            @if (Model.TekstJePrijedlog)
                            {
                                <p class="ev-prijedlog-hint">
                                    💡 Tekst obroka je predložen na osnovu prethodnog unosa za ovaj dan. Možete ga izmijeniti.
                                </p>
                            }
                            <div class="ev-obroci-grid">
                                @foreach (var obrok in obrociDef)
                                {
                                    <div class="ev-obrok-item">
                                        <label class="ev-obrok-label">@obrok.Naziv</label>

                                        <input type="text" name="@obrok.TekstName" class="ev-obrok-tekst"
                                               value="@obrok.Tekst" placeholder="@obrok.Placeholder" />

                                        <div class="ev-obrok-options">
                                            @foreach (var s in statusi)
                                            {
                                                <label class="ev-radio-label @(obrok.StatusVal == s.Val ? "ev-selected" : "")">
                                                    <input type="radio" name="@obrok.StatusName"
                                                           value="@s.Val"
                                                           @(obrok.StatusVal == s.Val ? "checked" : "")
                                                           onchange="updateRadioStyle(this)" />
                                                    <span>@s.Tekst</span>
                                                </label>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        @* ── Spavanje ── *@
                        <div class="ev-field">
                            <label class="ev-label">Spavanje</label>
                            <div class="ev-spavanje-row">
                                <div class="ev-time-group">
                                    <label class="ev-time-label">Od</label>
                                    <div class="ev-time-wrap">
                                        <input type="time"
                                               id="spavOd"
                                               value="@SpavaStart"
                                               min="08:00"
                                               max="16:00"
                                               class="ev-time-input"
                                               placeholder="HH:MM" />
                                        <span class="ev-time-icon">🕐</span>
                                    </div>
                                </div>
                                <div class="ev-time-group">
                                    <label class="ev-time-label">Do</label>
                                    <div class="ev-time-wrap">
                                        <input type="time"
                                               id="spavDo"
                                               value="@SpavaEnd"
                                               min="08:00"
                                               max="16:00"
                                               class="ev-time-input"
                                               placeholder="HH:MM" />
                                        <span class="ev-time-icon">🕐</span>
                                    </div>
                                </div>
                            </div>
                            <div id="spavanje-error" class="ev-inline-error" style="display:none;"></div>
                        </div>

                        @* ── Napomena ── *@
                        <div class="ev-field">
                            <label class="ev-label">Napomena</label>
                            <textarea name="Napomena" class="ev-textarea" rows="3"
                                      placeholder="Npr. Mirno spavao.">@Napomena</textarea>
                        </div>
                    </fieldset>

                    @if (Model.MozeUnositiAktivnosti)
                    {
                        <button type="submit" class="ev-submit" formnovalidate="formnovalidate" id="saveBtn">
                            💾 Sačuvaj zapis
                        </button>
                    }
                }
                else
                {
                    <p class="ev-placeholder-text">Odaberite dijete da biste unijeli aktivnosti.</p>
                }
            </form>
        </main>

<nav class="educator-bottom-nav">
    <a class="bottom-link" asp-controller="Home" asp-action="OdgajateljHome">
        <span>🏠</span> Početna
    </a>

    <a class="bottom-link" asp-controller="SazetakAktivnosti" asp-action="OdgajateljPregled">
        <span>📊</span> Sažeci
    </a>

    <a class="bottom-link active" asp-controller="DnevniIzvjestaj" asp-action="EvidencijaAktivnosti">
