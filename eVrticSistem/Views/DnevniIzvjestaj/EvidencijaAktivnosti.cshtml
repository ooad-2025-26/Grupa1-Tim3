@section Scripts {
<script>
    // When date changes, reload the page with new date + selected child
    function updateDatum(val) {
        var dijeteId = document.getElementById('dijeteSelect').value;
        var url = '@Url.Action("EvidencijaAktivnosti", "DnevniIzvjestaj")';
        url += '?datum=' + val;
        if (dijeteId) url += '&dijeteId=' + dijeteId;
        window.location.href = url;
    }

    // When child changes, navigate (don't submit the form) to load existing data
    function updateDijete(val) {
        var datum = document.getElementById('datumInput').value;
        var url = '@Url.Action("EvidencijaAktivnosti", "DnevniIzvjestaj")';
        if (val) {
            url += '?dijeteId=' + val;
            if (datum) url += '&datum=' + datum;
        } else if (datum) {
            url += '?datum=' + datum;
        }
        window.location.href = url;
    }

    // Highlight selected radio option
    function updateRadioStyle(radio) {
        var name = radio.name;
        document.querySelectorAll('input[name="' + name + '"]').forEach(function(r) {
            r.closest('.ev-radio-label').classList.remove('ev-selected');
        });
        radio.closest('.ev-radio-label').classList.add('ev-selected');
    }

    // Handle time input — split into hours/minutes hidden fields and validate sleep time
    document.addEventListener('DOMContentLoaded', function () {
        var form = document.getElementById('evForm') || document.querySelector('.ev-form');
        var spavOd = document.getElementById('spavOd');
        var spavDo = document.getElementById('spavDo');
        var spavanjeError = document.getElementById('spavanje-error');

        function setHidden(form, name, val) {
            if (!form) return;
            var el = form.querySelector('input[name="' + name + '"]');
            if (!el) {
                el = document.createElement('input');
                el.type = 'hidden';
                el.name = name;
                form.appendChild(el);
            }
            el.value = val;
        }

        function updateHiddenParts(timeInput, hourName, minName) {
            if (!timeInput) return;
            var parts = (timeInput.value || '').split(':');
            var form = timeInput.closest('form');
            setHidden(form, hourName, parts[0] || '');
            setHidden(form, minName, parts[1] || '');
        }

        function minutesFromTime(value) {
            if (!value) return null;
            var parts = value.split(':');
            if (parts.length !== 2) return NaN;

            var h = parseInt(parts[0], 10);
            var m = parseInt(parts[1], 10);
            if (isNaN(h) || isNaN(m)) return NaN;

            return h * 60 + m;
        }

        function showSleepError(message) {
            if (!spavanjeError) return;
            spavanjeError.textContent = message;
            spavanjeError.style.display = message ? 'block' : 'none';
        }

        function validateSleepTime(showMessage) {
            if (!spavOd || !spavDo) return true;

            var od = spavOd.value;
            var doVrijeme = spavDo.value;

            if (!od && !doVrijeme) {
                showSleepError('');
                return true;
            }

            if (!od || !doVrijeme) {
                if (showMessage) showSleepError('Unesite i početak i kraj spavanja.');
                return false;
            }

            var odMin = minutesFromTime(od);
            var doMin = minutesFromTime(doVrijeme);
            var minDozvoljeno = 8 * 60;
            var maxDozvoljeno = 16 * 60;

            if (isNaN(odMin) || isNaN(doMin)) {
                if (showMessage) showSleepError('Vrijeme spavanja nije ispravno uneseno.');
                return false;
            }

            if (odMin < minDozvoljeno || odMin > maxDozvoljeno || doMin < minDozvoljeno || doMin > maxDozvoljeno) {
                if (showMessage) showSleepError('Vrijeme spavanja mora biti između 08:00 i 16:00.');
                return false;
            }

            if (doMin <= odMin) {
                if (showMessage) showSleepError('Kraj spavanja mora biti poslije početka spavanja.');
                return false;
            }

            showSleepError('');
            return true;
        }

        function bindTimeInput(timeInput, hourName, minName) {
            if (!timeInput) return;

            timeInput.addEventListener('input', function () {
                updateHiddenParts(timeInput, hourName, minName);
                validateSleepTime(true);
            });

            timeInput.addEventListener('change', function () {
                updateHiddenParts(timeInput, hourName, minName);
                validateSleepTime(true);
            });

            updateHiddenParts(timeInput, hourName, minName);
        }

        bindTimeInput(spavOd, 'SpavanjePocetakSati', 'SpavanjePocetakMinuta');
        bindTimeInput(spavDo, 'SpavanjeKrajSati', 'SpavanjeKrajMinuta');

        if (form) {
            form.addEventListener('submit', function (event) {
                updateHiddenParts(spavOd, 'SpavanjePocetakSati', 'SpavanjePocetakMinuta');
                updateHiddenParts(spavDo, 'SpavanjeKrajSati', 'SpavanjeKrajMinuta');

                if (!validateSleepTime(true)) {
                    event.preventDefault();
                }
            });
        }

        // Initialize radio styles on load
        document.querySelectorAll('.ev-radio-label input[type="radio"]:checked').forEach(function(r) {
            r.closest('.ev-radio-label').classList.add('ev-selected');
        });
    });
</script>
}


