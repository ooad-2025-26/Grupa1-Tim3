@page
@model ResetPasswordModel

@{
    ViewData["Title"] = "Nova lozinka";
}

<div class="login-page">
    <div class="login-card">

        <section class="login-left">
            <div class="sun">☀</div>
            <div class="cloud cloud-1"></div>
            <div class="cloud cloud-2"></div>

            <div class="logo-text">eVrtić</div>
            <h2>Nova lozinka</h2>
            <p>Postavite novu lozinku za nalog</p>

            <div class="kindergarten">
                <div class="tree tree-left"></div>
                <div class="tree tree-right"></div>

                <div class="school">
                    <div class="roof"></div>
                    <div class="building">
                        <div class="window"></div>
                        <div class="door"></div>
                        <div class="window"></div>
                    </div>
                </div>

                <div class="children-row">
                    <span>🧒</span>
                    <span>👧</span>
                    <span>👦</span>
                </div>
            </div>
        </section>

        <section class="login-right">
            <div class="login-box">
                <h3>Postavljanje nove lozinke</h3>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <input asp-for="Input.UserId" type="hidden" />
                    <input asp-for="Input.Code" type="hidden" />

                    @if (!string.IsNullOrEmpty(Model.Email))
                    {
                        <div class="reset-account">
                            <span class="reset-account-lbl">Nalog</span>
                            <span class="reset-account-mail">✉ @Model.Email</span>
                        </div>
                    }

                    <div class="input-group-custom">
                        <span>🔒</span>
                        <input asp-for="Input.Password" autocomplete="new-password" aria-required="true" placeholder="Nova lozinka" />
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>

                    <div class="input-group-custom">
                        <span>🔒</span>
                        <input asp-for="Input.ConfirmPassword" autocomplete="new-password" aria-required="true" placeholder="Potvrdi lozinku" />
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>

                    <button type="submit" class="login-button" style="margin-top:24px;">
                        Promijeni lozinku
                    </button>

                    <div class="register-link">
                        <a asp-page="./Login">Nazad na prijavu</a>
                    </div>
                </form>
            </div>
        </section>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    .reset-account {
        display: flex;
        flex-direction: column;
        gap: 4px;
        background: #f5f9ff;
        border: 1px solid #dce4f0;
        border-radius: 10px;
        padding: 12px 16px;
        margin-bottom: 18px;
    }

    .reset-account-lbl {
        font-size: 0.72rem;
        color: #94a3b8;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .reset-account-mail {
        color: #16233b;
        font-weight: 700;
        font-size: 1rem;
    }
</style>
