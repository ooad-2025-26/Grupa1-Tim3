@page
@model ResetPasswordConfirmationModel

@{
    ViewData["Title"] = "Lozinka promijenjena";
}

<div class="login-page">
    <div class="login-card">

        <section class="login-left">
            <div class="sun">☀</div>
            <div class="cloud cloud-1"></div>
            <div class="cloud cloud-2"></div>

            <div class="logo-text">eVrtić</div>
            <h2>Gotovo!</h2>
            <p>Lozinka je uspješno promijenjena</p>

            <div class="kindergarten">
                <div class="tree tree-left"></div>
                <div class="tree tree-right"></div>

                <div class="school">
                    <div class="roof"></div>
                    <div class="building">
                        <div class="window"></div>
                        <div class="door"></div>
                        <div class="window"></div>
                    </div>
                </div>

                <div class="children-row">
                    <span>🧒</span>
                    <span>👧</span>
                    <span>👦</span>
                </div>
            </div>
        </section>

        <section class="login-right">
            <div class="login-box" style="text-align:center;">
                <div class="reset-big-icon">✅</div>
                <h3>Lozinka promijenjena</h3>

                <p class="reset-intro">
                    Vaša lozinka je uspješno promijenjena. Sada se možete prijaviti
                    s novom lozinkom.
                </p>

                <a asp-page="./Login" class="login-button" style="display:flex; align-items:center; justify-content:center; text-decoration:none;">
                    Prijavite se
                </a>
            </div>
        </section>

    </div>
</div>

<style>
    .reset-big-icon {
        font-size: 56px;
        margin-bottom: 14px;
    }

    .reset-intro {
        color: #5c6678;
        font-size: 16px;
        line-height: 1.5;
        margin: 0 0 26px;
        text-align: center;
    }
</style>
