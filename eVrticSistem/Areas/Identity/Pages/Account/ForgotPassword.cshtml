@page
@model ForgotPasswordModel

@{
    ViewData["Title"] = "Zaboravljena lozinka";
}

<div class="login-page">
    <div class="login-card">

        <section class="login-left">
            <div class="sun">☀</div>
            <div class="cloud cloud-1"></div>
            <div class="cloud cloud-2"></div>

            <div class="logo-text">eVrtić</div>
            <h2>Zaboravljena lozinka</h2>
            <p>Poslat ćemo vam link na email</p>

            <div class="kindergarten">
                <div class="tree tree-left"></div>
                <div class="tree tree-right"></div>

                <div class="school">
                    <div class="roof"></div>
                    <div class="building">
                        <div class="window"></div>
                        <div class="door"></div>
                        <div class="window"></div>
                    </div>
                </div>

                <div class="children-row">
                    <span>🧒</span>
                    <span>👧</span>
                    <span>👦</span>
                </div>
            </div>
        </section>

        <section class="login-right">
            <div class="login-box">
                <h3>Resetovanje lozinke</h3>

                <p class="reset-intro">
                    Unesite email adresu povezanu s vašim nalogom. Poslat ćemo vam link
                    pomoću kojeg možete postaviti novu lozinku.
                </p>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <div class="input-group-custom">
                        <span>✉</span>
                        <input asp-for="Input.Email" autocomplete="username" aria-required="true" placeholder="Email" />
                    </div>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>

                    <button type="submit" class="login-button" style="margin-top:24px;">
                        Pošalji link
                    </button>

                    <div class="register-link">
                        Sjetili ste se lozinke?
                        <a asp-page="./Login">Prijavite se</a>
                    </div>
                </form>
            </div>
        </section>

    </div>
</div>

<style>
    .reset-intro {
        color: #5c6678;
        font-size: 16px;
        line-height: 1.5;
        margin: 0 0 26px;
        text-align: center;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
