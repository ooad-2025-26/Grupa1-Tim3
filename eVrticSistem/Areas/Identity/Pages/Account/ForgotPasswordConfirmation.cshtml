@page
@model ForgotPasswordConfirmationModel

@{
    ViewData["Title"] = "Provjerite email";
}

<div class="login-page">
    <div class="login-card">

        <section class="login-left">
            <div class="sun">☀</div>
            <div class="cloud cloud-1"></div>
            <div class="cloud cloud-2"></div>

            <div class="logo-text">eVrtić</div>
            <h2>Provjerite email</h2>
            <p>Poslali smo vam link za reset</p>

            <div class="kindergarten">
                <div class="tree tree-left"></div>
                <div class="tree tree-right"></div>

                <div class="school">
                    <div class="roof"></div>
                    <div class="building">
                        <div class="window"></div>
                        <div class="door"></div>
                        <div class="window"></div>
                    </div>
                </div>

                <div class="children-row">
                    <span>🧒</span>
                    <span>👧</span>
                    <span>👦</span>
                </div>
            </div>
        </section>

        <section class="login-right">
            <div class="login-box" style="text-align:center;">
                <div class="reset-big-icon">📧</div>
                <h3>Provjerite svoj email</h3>

                <p class="reset-intro">
                    Ako postoji nalog povezan s unesenom email adresom, poslali smo
                    poruku s linkom za postavljanje nove lozinke. Provjerite i folder
                    neželjene pošte (spam).
                </p>

                <a asp-page="./Login" class="login-button" style="display:flex; align-items:center; justify-content:center; text-decoration:none;">
                    Nazad na prijavu
                </a>
            </div>
        </section>

    </div>
</div>

<style>
    .reset-big-icon {
        font-size: 56px;
        margin-bottom: 14px;
    }

    .reset-intro {
        color: #5c6678;
        font-size: 16px;
        line-height: 1.5;
        margin: 0 0 26px;
        text-align: center;
    }
</style>
